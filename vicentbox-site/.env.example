# VicentBOX - Environment Variables
# Copy this file to .env and fill in your values

# Site Configuration
SITE_URL=https://vicentbox.com.br

# Analytics & Tracking
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GTM_CONTAINER_ID=GTM-XXXXXXX
META_PIXEL_ID=XXXXXXXXXXXXXX
GOOGLE_ADS_CONVERSION_ID=XXXXXXXXXX
GOOGLE_ADS_CONVERSION_LABEL=XXXXXXXXXXXXXX

# Forms (Formspree)
FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Optional: reCAPTCHA / Turnstile
TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxx