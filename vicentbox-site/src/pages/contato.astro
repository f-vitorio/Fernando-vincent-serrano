---
import Layout from '@layouts/Layout.astro';
import { siteConfig } from '@types';
import Hero from '@components/sections/Hero.astro';
import WhatsAppCtaCard from '@components/sections/WhatsAppCtaCard.astro';
import Container from '@components/ui/Container.astro';
import Section from '@components/ui/Section.astro';
import Card from '@components/ui/Card.astro';
import Button from '@components/ui/Button.astro';
import MapPin from '@components/ui/icons/MapPin.astro';
import Phone from '@components/ui/icons/Phone.astro';
import Mail from '@components/ui/icons/Mail.astro';
import Clock from '@components/ui/icons/Clock.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import {
  generateBreadcrumbListJSONLD,
  generateContactPageJSONLD,
} from '@utils/jsonld';

const breadcrumbItems = [
  { name: 'Início', url: '/' },
  { name: 'Contato', url: '/contato' },
];

const contatoJsonLd = [
  generateContactPageJSONLD({
    name: 'Contato — VicentBOX Personal Trainer em Maringá',
    description:
      'WhatsApp (44) 99921-8147, e-mail e endereço do studio VicentBOX em Maringá/PR. Horários de atendimento e localização.',
    url: '/contato',
  }),
  generateBreadcrumbListJSONLD(breadcrumbItems),
];
---

<Layout
  title="Contato VicentBOX | WhatsApp e Endereço em Maringá"
  description="Fale com a VicentBOX em Maringá: WhatsApp (44) 99921-8147, e-mail e endereço na Rua Néo Alves Martins 2447. Horários de atendimento."
  jsonLd={contatoJsonLd}
>
  <Breadcrumb items={breadcrumbItems} />
  <Hero
    title="Contato da VicentBOX em Maringá"
    subtitle="Tire dúvidas, agende sua avaliação ou venha nos conhecer. Estamos prontos para te atender."
    ctaText="Chamar no WhatsApp"
    ctaHref="https://wa.me/5544999218147?text=Olá! Vim pelo site da VicentBOX. Gostaria de mais informações."
    ctaTrackSource="hero"
    badge="Atendimento humano | Sem compromisso de plano | WhatsApp direto"
    image="/images/hero-personal-trainer.jpg"
    imageAlt="Personal trainer acompanhando aluna em exercício no studio VicentBOX"
    stats={[
      { value: '7h-18h', label: 'Seg, Qua e Sex' },
      { value: '7h-21h', label: 'Ter e Qui' },
    ]}
  />

  <Section id="formulario" background="white" aria-labelledby="form-title">
    <Container>
      <div class="grid lg:grid-cols-2 gap-fluid-10">
        <div>
          <h2 id="form-title" class="text-fluid-2xl font-heading font-semibold text-white mb-4">Fale com a gente</h2>
          <p class="text-fluid-base text-neutral-300 mb-8">Toda a conversa acontece no WhatsApp: clique, escreva sua mensagem e retornamos no mesmo canal.</p>
        </div>
        <div>
          <WhatsAppCtaCard
            source="contato"
            title="Enviar mensagem pelo WhatsApp"
            subtitle="Dúvida, agendamento, parceria ou orçamento — respondemos em horário comercial."
            ctaText="Abrir Conversa no WhatsApp"
            message="Olá! Vim pelo site da VicentBOX. Gostaria de falar sobre: "
          />
        </div>
      </div>
    </Container>
  </Section>

  <Section id="info-contato" background="neutral-50" aria-labelledby="info-title">
    <Container>
      <header class="heading-section">
        <h2 id="info-title" class="heading-section-title">Outras formas de contato</h2>
        <p class="heading-section-subtitle">Escolha a que for mais cómoda para você</p>
      </header>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <Card class="card-hover p-6 text-center">
          <div class="icon-wrapper icon-wrapper-primary mx-auto mb-4">
            <MapPin class="w-6 h-6" />
          </div>
          <h3 class="text-fluid-lg font-heading font-semibold text-white mb-2">Endereço</h3>
          <address class="not-italic text-fluid-base text-neutral-300 leading-relaxed">
            <p>{siteConfig.address.street}</p>
            <p>{siteConfig.address.neighborhood}</p>
            <p>{siteConfig.address.city} - {siteConfig.address.state}</p>
            <p>{siteConfig.address.zipCode}</p>
          </address>
          <a
            href={siteConfig.googleBusinessProfile}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center gap-1 text-fluid-sm text-accent-400 hover:underline"
            data-track="cta_click"
            data-track-source="gbp_profile"
          >
            <MapPin class="w-4 h-4" aria-hidden="true" />
            Ver perfil no Google
          </a>
        </Card>

        <Card class="card-hover p-6 text-center">
          <div class="icon-wrapper icon-wrapper-secondary mx-auto mb-4">
            <Phone class="w-6 h-6" />
          </div>
          <h3 class="text-fluid-lg font-heading font-semibold text-white mb-2">WhatsApp</h3>
          <a href={`https://wa.me/${siteConfig.whatsappNumber}`} target="_blank" rel="noopener noreferrer" class="text-fluid-xl font-heading font-semibold text-white block mb-2">{siteConfig.phoneFormatted}</a>
          <p class="text-fluid-base text-neutral-300 mb-4">Resposta em minutos no horário comercial</p>
          <Button
            variant="whatsapp"
            href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Olá! Vim pelo site da VicentBOX. Gostaria de mais informações.')}`}
            data-track="cta_click"
            data-track-source="whatsapp_card"
          >
            Abrir Conversa
          </Button>
        </Card>

        <Card class="card-hover p-6 text-center">
          <div class="icon-wrapper icon-wrapper-accent mx-auto mb-4">
            <Mail class="w-6 h-6" />
          </div>
          <h3 class="text-fluid-lg font-heading font-semibold text-white mb-2">E-mail</h3>
          <a href={`mailto:${siteConfig.email}`} class="text-fluid-base text-white block mb-4">{siteConfig.email}</a>
          <p class="text-fluid-base text-neutral-300 mb-4">Para dúvidas detalhadas, envio de documentos, parcerias B2B</p>
          <Button
            variant="outline"
            href={`mailto:${siteConfig.email}?subject=Contato via Site - VicentBOX`}
            data-track="cta_click"
            data-track-source="email_card"
          >
            Enviar E-mail
          </Button>
        </Card>

        <Card class="card-hover p-6 text-center">
          <div class="icon-wrapper icon-wrapper-primary mx-auto mb-4">
            <Clock class="w-6 h-6" />
          </div>
          <h3 class="text-fluid-lg font-heading font-semibold text-white mb-2">Horários de Atendimento</h3>
          <div class="space-y-2 text-fluid-base text-neutral-300">
            <p><strong>Seg, Qua e Sex:</strong> 7h às 18h</p>
            <p><strong>Ter e Qui:</strong> 7h às 21h</p>
            <p><strong>Demais dias:</strong> sob consulta</p>
          </div>
          <p class="text-fluid-sm text-neutral-400 mt-4">Fora do horário? Deixe mensagem no WhatsApp que retornamos no próximo dia útil.</p>
        </Card>
      </div>
    </Container>
  </Section>

  <Section id="mapa" background="white" aria-labelledby="mapa-title">
    <Container>
      <header class="heading-section">
        <h2 id="mapa-title" class="heading-section-title">Como chegar</h2>
        <p class="heading-section-subtitle">Endereço do studio VicentBOX — abra o perfil oficial no Google</p>
      </header>
      <div class="rounded-2xl overflow-hidden border border-white/10 shadow-card">
        <iframe
          src={`https://www.google.com/maps?cid=6061027470552195231&output=embed`}
          title={`Mapa da VicentBOX — ${siteConfig.address.full}`}
          class="w-full h-72 md:h-96"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
      <p class="text-center mt-6">
        <a
          href={siteConfig.googleBusinessProfile}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
          data-track="cta_click"
          data-track-source="gbp_embed"
        >
          Abrir perfil e rotas no Google
        </a>
      </p>
    </Container>
  </Section>

</Layout>