---
import Layout from '@layouts/Layout.astro';
import Container from '@components/ui/Container.astro';
import Section from '@components/ui/Section.astro';
import Button from '@components/ui/Button.astro';
import CTA from '@components/sections/CTA.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import { generateBreadcrumbListJSONLD } from '@utils/jsonld';

const waVisit =
  'https://wa.me/5544999218147?text=Olá! Vim pelo site da VicentBOX. Gostaria de agendar uma visita ao studio.';

const breadcrumbItems = [
  { name: 'Início', url: '/' },
  { name: 'Galeria', url: '/galeria' },
];

const galeriaJsonLd = [generateBreadcrumbListJSONLD(breadcrumbItems)];

const photos = [
  { src: '/images/galeria-aquecimento.jpg', label: 'Aquecimento em grupo', alt: 'Grupo de alunos da VicentBOX fazendo aquecimento ao ar livre com os braços levantados' },
  { src: '/images/galeria-corrida-1552.jpg', label: 'Corrida de rua', alt: 'Aluna da VicentBOX em prova de corrida de rua com camisa amarela' },
  { src: '/images/galeria-trofeus.jpg', label: 'Pódio e troféus', alt: 'Aluna sênior da VicentBOX segurando troféus após prova de corrida' },
  { src: '/images/galeria-medalha-jovem.jpg', label: 'Medalha conquistada', alt: 'Aluna sorrindo com medalha de corrida no pescoço' },
  { src: '/images/galeria-corrida-105.jpg', label: 'Treino de rua', alt: 'Aluna em prova de corrida com camisa amarela e número 105' },
  { src: '/images/galeria-coracao-1030.jpg', label: 'Corrida beneficente', alt: 'Aluna fazendo coração com as mãos durante corrida beneficente' },
  { src: '/images/galeria-medalha-masculina.jpg', label: 'Resultado que motiva', alt: 'Aluno da VicentBOX apontando para a medalha conquistada na corrida' },
  { src: '/images/galeria-corrida-verde.jpg', label: 'Em prova', alt: 'Aluna da VicentBOX correndo com camisa verde em prova de rua' },
  { src: '/images/galeria-kids-medalhas.jpg', label: 'Corrida Kids', alt: 'Duas crianças com medalhas da corrida Kids VicentBOX' },
  { src: '/images/galeria-corrida-noite.jpg', label: 'Treino ao entardecer', alt: 'Aluna da VicentBOX correndo na cidade com iluminação noturna' },
  { src: '/images/galeria-medalhas-dupla.jpg', label: 'Juntas são mais fortes', alt: 'Duas alunas da VicentBOX com medalhas de corrida' },
  { src: '/images/galeria-corrida-5959.jpg', label: 'Foco na prova', alt: 'Aluna da VicentBOX em corrida de rua com óculos e número 5959' },
  { src: '/images/galeria-corrida-sorrindo.jpg', label: 'Chegada com sorriso', alt: 'Aluna sênior sorrindo após concluir prova de corrida' },
  { src: '/images/galeria-giovana.jpg', label: 'Equipe VicentBOX', alt: 'Giovana, integrante da equipe VicentBOX, de braços cruzados no studio' },
  { src: '/images/galeria-palestra.jpg', label: 'Palestras e eventos', alt: 'Público em palestra promovida pela VicentBOX em auditório' },
  { src: '/images/fernando-serrano.jpg', label: 'Fernando Serrano Vicentin', alt: 'Fernando Serrano Vicentin, fundador da VicentBOX, de braços cruzados no studio' },
  { src: '/images/fernando-studio.jpg', label: 'No studio', alt: 'Fernando Serrano Vicentin, personal trainer da VicentBOX, no studio em Maringá' },
];
---

<Layout
  title="Galeria VicentBOX | Fotos Reais de Treinos e Corridas em Maringá"
  description="Fotos reais dos alunos da VicentBOX: corridas de rua, medalhas, treinos, palestras e eventos em Maringá/PR. Veja de perto o método do personal Fernando Serrano."
  jsonLd={galeriaJsonLd}
>
  <Breadcrumb items={breadcrumbItems} />

  <!-- HERO com foto real em parallax -->
  <header class="relative overflow-hidden bg-primary-950" aria-labelledby="galeria-title">
    <div class="absolute inset-0" aria-hidden="true">
      <div class="absolute -inset-y-[20%] inset-x-0" data-parallax="0.08">
        <picture>
          <source srcset="/images/galeria-aquecimento.webp" type="image/webp" />
          <img
            src="/images/galeria-aquecimento.jpg"
            alt=""
            width="1080"
            height="1350"
            class="w-full h-full object-cover object-center"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-primary-950 via-primary-950/80 to-primary-950/45"></div>
      <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-accent-400/15 blur-3xl"></div>
    </div>

    <Container class="relative py-fluid-14 md:py-fluid-20 text-center">
      <div class="flex flex-wrap justify-center gap-2 mb-5 animate-fade-in">
        <span class="badge badge-primary">Fotos reais dos alunos</span>
        <span class="badge badge-primary">Maringá/PR</span>
        <span class="badge badge-primary hidden sm:inline-flex">Corridas · Treinos · Eventos</span>
      </div>

      <h1
        id="galeria-title"
        class="text-fluid-4xl md:text-fluid-5xl font-heading font-bold text-white text-balance mb-4 animate-slide-up"
      >
        A VicentBOX <em class="not-italic text-accent-400">em fotos</em>
      </h1>

      <p class="text-fluid-base lg:text-fluid-lg text-neutral-300 mb-6 max-w-2xl mx-auto animate-slide-up stagger-1">
        Corridas de rua, medalhas, treinos e eventos. Aqui são fotos de aluno de
        verdade — resultado que dá para ver antes de começar.
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 mb-7 animate-slide-up stagger-2">
        <Button
          href={waVisit}
          variant="whatsapp"
          size="lg"
          data-track="cta_click"
          data-track-source="galeria_hero"
          class="w-full sm:w-auto"
        >
          Agendar minha avaliação
        </Button>
        <Button
          href="#fotos"
          variant="ghost"
          size="lg"
          data-track="cta_click"
          data-track-source="galeria_hero_ver_fotos"
          class="w-full sm:w-auto"
        >
          Ver as fotos ↓
        </Button>
      </div>

      <div
        class="flex flex-wrap items-stretch justify-center gap-x-6 gap-y-4 py-4 border-y border-white/10 animate-slide-up stagger-3 max-w-2xl mx-auto"
        role="list"
        aria-label="Destaques"
      >
        <div class="flex-1 min-w-[7rem] max-w-[11rem] text-center" role="listitem">
          <div class="text-fluid-xl font-heading font-bold text-accent-400 leading-tight">19+</div>
          <div class="text-fluid-xs text-neutral-400 mt-0.5">Anos de experiência</div>
        </div>
        <div class="flex-1 min-w-[7rem] max-w-[11rem] text-center lg:border-l lg:border-white/10 lg:pl-6" role="listitem">
          <div class="text-fluid-xl font-heading font-bold text-accent-400 leading-tight">3</div>
          <div class="text-fluid-xs text-neutral-400 mt-0.5">Alunos por turma (máx.)</div>
        </div>
        <div class="flex-1 min-w-[7rem] max-w-[11rem] text-center lg:border-l lg:border-white/10 lg:pl-6" role="listitem">
          <div class="text-fluid-xl font-heading font-bold text-accent-400 leading-tight">5 min</div>
          <div class="text-fluid-xs text-neutral-400 mt-0.5">Terapia manual/aula</div>
        </div>
      </div>
    </Container>
  </header>

  <!-- GALERIA em masonry com reveal + lightbox -->
  <Section id="fotos" background="white" number="01" aria-labelledby="fotos-title">
    <Container>
      <header class="heading-section">
        <h2 id="fotos-title" class="heading-section-title">Galeria completa</h2>
        <p class="heading-section-subtitle">
          Toque em qualquer foto para ampliar. Use as setas para navegar.
        </p>
      </header>

      <div class="columns-1 sm:columns-2 lg:columns-3 gap-4 [column-fill:_balance]">
        {photos.map((photo) => (
          <figure
            class="group relative break-inside-avoid mb-4 rounded-xl overflow-hidden bg-primary-900 border border-white/10 reveal cursor-zoom-in"
            data-lightbox
            data-caption={photo.label}
            role="button"
            tabindex="0"
            aria-label={`Ampliar foto: ${photo.alt}`}
          >
            <picture>
              <source srcset={photo.src.replace(/\.jpg$/, '.webp')} type="image/webp" />
              <img
                src={photo.src}
                alt={photo.alt}
                width="1000"
                height="1250"
                loading="lazy"
                decoding="async"
                class="w-full h-auto transition-transform duration-700 group-hover:scale-105"
              />
            </picture>
            <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-neutral-950/85 via-neutral-950/30 to-transparent p-4 pt-10 opacity-0 translate-y-2 transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0">
              <span class="text-fluid-sm font-medium text-white">{photo.label}</span>
            </figcaption>
            <span
              class="absolute top-3 right-3 w-9 h-9 rounded-full bg-primary-950/60 border border-white/25 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300"
              aria-hidden="true"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4">
                <path stroke-linecap="round" d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
              </svg>
            </span>
          </figure>
        ))}
      </div>

      <div class="text-center mt-10 reveal">
        <p class="text-fluid-base text-neutral-300 mb-4">
          Quer fazer parte dessas fotos?
        </p>
        <Button
          variant="whatsapp"
          size="lg"
          href={waVisit}
          data-track="cta_click"
          data-track-source="galeria_grid"
        >
          Começar pela avaliação gratuita
        </Button>
      </div>
    </Container>
  </Section>

  <!-- FAIXA em parallax com prova social + CTA -->
  <section class="relative overflow-hidden" aria-label="Convite para conhecer a VicentBOX">
    <div class="absolute inset-0" aria-hidden="true">
      <div class="absolute -inset-y-[25%] inset-x-0" data-parallax="0.1">
        <picture>
          <source srcset="/images/galeria-palestra.webp" type="image/webp" />
          <img
            src="/images/galeria-palestra.jpg"
            alt=""
            width="1080"
            height="1350"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover object-center"
          />
        </picture>
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-primary-950 via-primary-950/85 to-primary-950/55"></div>
    </div>

    <Container class="relative py-fluid-16 md:py-fluid-20">
      <div class="max-w-2xl">
        <p class="text-fluid-xs font-semibold tracking-[0.18em] uppercase text-accent-400 mb-4 reveal">
          Sua vez
        </p>
        <h2 class="text-fluid-3xl font-heading font-bold text-white text-balance mb-4 reveal">
          Sua próxima foto pode ser <em class="not-italic text-accent-400">aqui</em>
        </h2>
        <p class="text-fluid-base text-neutral-300 mb-6 reveal">
          Comece pela avaliação gratuita: entendemos seus objetivos, fazemos os
          testes de movimento e definimos o treino certo para você — turma de até
          3 pessoas e terapia manual em toda aula.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 reveal">
          <Button
            href={waVisit}
            variant="whatsapp"
            size="lg"
            data-track="cta_click"
            data-track-source="galeria_parallax"
            class="w-full sm:w-auto"
          >
            Agendar avaliação no WhatsApp
          </Button>
          <Button
            href="/sobre"
            variant="ghost"
            size="lg"
            data-track="cta_click"
            data-track-source="galeria_parallax_sobre"
            class="w-full sm:w-auto"
          >
            Conhecer o Fernando
          </Button>
        </div>
      </div>
    </Container>
  </section>

  <CTA
    title="Vem conhecer de perto?"
    subtitle="A melhor forma de sentir o ambiente é estando aqui. Agende sua visita sem compromisso."
    ctaText="Agendar Visita pelo WhatsApp"
    ctaHref={waVisit}
    ctaTrackSource="galeria_cta"
    background="primary-600"
  />
</Layout>
