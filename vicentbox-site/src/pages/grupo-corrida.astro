---
import Layout from '@layouts/Layout.astro';
import { siteConfig, benefitsCorrida, faqCorrida } from '@types';
import Hero from '@components/sections/Hero.astro';
import Features from '@components/sections/Features.astro';
import Offer from '@components/sections/Offer.astro';
import FAQ from '@components/sections/FAQ.astro';
import CTA from '@components/sections/CTA.astro';
import WhatsAppCtaCard from '@components/sections/WhatsAppCtaCard.astro';
import ShieldCheck from '@components/ui/icons/ShieldCheck.astro';
import Users from '@components/ui/icons/Users.astro';
import Target from '@components/ui/icons/Target.astro';
import Timer from '@components/ui/icons/Timer.astro';
import Smartphone from '@components/ui/icons/Smartphone.astro';
import GraduationCap from '@components/ui/icons/GraduationCap.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Container from '@components/ui/Container.astro';
import Section from '@components/ui/Section.astro';
import { generateServiceJSONLD, generateBreadcrumbListJSONLD, generateFAQPageJSONLD } from '@utils/jsonld';

const breadcrumbItems = [
  { name: 'Início', url: '/' },
  { name: 'Serviços', url: '/servicos' },
  { name: 'Grupo de Corrida', url: '/grupo-corrida' },
];

const service = {
  name: 'Grupo de Corrida',
  description: 'Corrida de rua presencial 3x/semana (até 50 alunos) ou consultoria online de corrida, com acompanhamento do treino.',
  price: '100',
  url: '/grupo-corrida',
  image: '/images/grupo-corrida.jpg',
};

const serviceJsonLd = generateServiceJSONLD(service);
const breadcrumbJsonLd = generateBreadcrumbListJSONLD(breadcrumbItems);
const faqJsonLd = generateFAQPageJSONLD(faqCorrida);
---

<Layout
  title="Grupo de Corrida em Maringá | Presencial e Online | VicentBOX"
  description="Grupo de corrida em Maringá: presencial 3x/semana R$100/mês ou consultoria online R$50/mês. Acompanhamento para diferentes níveis."
  jsonLd={[serviceJsonLd, breadcrumbJsonLd, faqJsonLd]}
>
  <Breadcrumb items={breadcrumbItems} />
  <Hero
    title="Grupo de Corrida em Maringá — Presencial e Online"
    subtitle="Corrida de rua presencial 3x por semana em Maringá ou consultoria online, com acompanhamento do treino. Iniciantes e corredores experientes são bem-vindos."
    ctaText="Entrar no Grupo"
    ctaHref="https://wa.me/5544999218147?text=Olá! Vim pelo site da VicentBOX. Tenho interesse no Grupo de Corrida. Gostaria de mais informações."
    ctaTrackSource="hero"
    badge="Presencial 3x/semana | Online | Acompanhamento do treino"
    image="/images/grupo-corrida.jpg"
    imageAlt="Grupo de corredores em treino ao ar livre — Grupo de Corrida VicentBOX Maringá"
    stats={[
      { value: '3x/sem', label: 'Treinos presenciais' },
      { value: '50', label: 'Alunos por hora (máx.)' },
      { value: 'R$ 100', label: 'Presencial/mês' },
    ]}
  />

  <!-- Marca do produto -->
  <Section size="sm" background="white" ariaLabel="Marca VicentBOX running">
    <Container>
      <figure class="max-w-xs mx-auto text-center">
        <picture>
          <source srcset="/images/logo-vicentbox-running.webp" type="image/webp" />
          <img
            src="/images/logo-vicentbox-running.jpg"
            alt="Logo VicentBOX running"
            width="472"
            height="472"
            class="w-full rounded-xl"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption class="mt-3 text-fluid-sm text-neutral-400">
          O grupo de corrida é um produto da marca VicentBOX running
        </figcaption>
      </figure>
    </Container>
  </Section>

  <Features
    title="Por que o Grupo de Corrida VicentBOX funciona"
    subtitle="Acompanhamento de verdade, do iniciante ao corredor experiente:"
    features={benefitsCorrida}
  >
    <ShieldCheck slot="shield-check" class="w-6 h-6" />
    <Timer slot="timer" class="w-6 h-6" />
    <Users slot="users" class="w-6 h-6" />
    <Target slot="target" class="w-6 h-6" />
    <GraduationCap slot="graduation-cap" class="w-6 h-6" />
    <Smartphone slot="smartphone" class="w-6 h-6" />
  </Features>

  <Offer
    title="Dois formatos, mesmo acompanhamento"
    subtitle="Escolha o que cabe na sua rotina:"
    plans={[
      {
        name: 'Presencial',
        price: 'R$ 100',
        period: '/mês',
        features: [
          '3 treinos presenciais/semana em Maringá',
          'Até 50 alunos por hora',
          'Acompanhamento do treino',
          'Para diferentes níveis de corredores',
          'Horários conforme agenda do grupo',
        ],
        ctaText: 'Quero treinar presencial',
        ctaHref: 'https://wa.me/5544999218147?text=Olá! Vim pelo site da VicentBOX. Quero o Grupo de Corrida Presencial 3x/semana (R$100/mês). Gostaria de agendar.',
        ctaVariant: 'whatsapp',
        popular: true,
      },
      {
        name: 'Online',
        price: 'R$ 50',
        period: '/mês',
        features: [
          'Consultoria online de corrida',
          'Acompanhamento do treino',
          'Treino no celular, onde e quando quiser',
          'Para diferentes níveis de corredores',
          'Iniciantes são bem-vindos',
        ],
        ctaText: 'Quero treinar online',
        ctaHref: 'https://wa.me/5544999218147?text=Olá! Vim pelo site da VicentBOX. Quero a Consultoria Online de Corrida (R$50/mês). Gostaria de agendar.',
        ctaVariant: 'whatsapp',
      },
    ]}
  />

  <FAQ
    title="Dúvidas frequentes sobre o Grupo de Corrida"
    faqs={faqCorrida}
  />

  <WhatsAppCtaCard
    source="corrida"
    title="Pronto para calçar o tênis?"
    subtitle="Chame no WhatsApp e definimos juntos seu nível, objetivo e melhor formato de treino."
    ctaText="Entrar no Grupo pelo WhatsApp"
    message="Olá! Vim pelo site da VicentBOX. Quero entrar no Grupo de Corrida. Pode me passar os detalhes?"
  />

  <Section id="relacionados" background="neutral-50" aria-labelledby="relacionados-title">
    <Container>
      <header class="heading-section">
        <h2 id="relacionados-title" class="heading-section-title">Outros serviços da VicentBOX</h2>
        <p class="heading-section-subtitle">Para complementar sua rotina de treino:</p>
      </header>
      <ul class="grid sm:grid-cols-3 gap-4 text-fluid-sm">
        <li class="card">
          <a href="/treinamento-multifuncional" class="font-semibold text-accent-400 hover:underline">Treinamento Multifuncional</a>
          <p class="text-neutral-300 mt-1">Turmas de até 3 com terapia manual em Maringá.</p>
        </li>
        <li class="card">
          <a href="/consultoria-online" class="font-semibold text-accent-400 hover:underline">Consultoria Online</a>
          <p class="text-neutral-300 mt-1">Treino no app por R$ 39,90/mês.</p>
        </li>
        <li class="card">
          <a href="/servicos" class="font-semibold text-accent-400 hover:underline">Todos os serviços</a>
          <p class="text-neutral-300 mt-1">Alongamento, relaxamento, desafio 15 dias e palestras.</p>
        </li>
      </ul>
    </Container>
  </Section>

  <CTA
    title="Pronto para entrar no grupo?"
    subtitle="Fale com a gente no WhatsApp e escolha o formato presencial ou online."
    ctaText="Falar no WhatsApp"
    ctaHref="https://wa.me/5544999218147?text=Olá! Vim pelo site da VicentBOX. Tenho dúvidas sobre o Grupo de Corrida."
    ctaTrackSource="final_cta"
    background="primary-600"
  />
</Layout>