---
import Layout from '@layouts/Layout.astro';
import { siteConfig } from '@types';
import Hero from '@components/sections/Hero.astro';
import Methodology from '@components/sections/Methodology.astro';
import CTA from '@components/sections/CTA.astro';
import Container from '@components/ui/Container.astro';
import Section from '@components/ui/Section.astro';
import Card from '@components/ui/Card.astro';
import Button from '@components/ui/Button.astro';
import ShieldCheck from '@components/ui/icons/ShieldCheck.astro';
import Dumbbell from '@components/ui/icons/Dumbbell.astro';
import Sparkles from '@components/ui/icons/Sparkles.astro';
import Users from '@components/ui/icons/Users.astro';
import HeartPulse from '@components/ui/icons/HeartPulse.astro';
import Target from '@components/ui/icons/Target.astro';
import Calendar from '@components/ui/icons/Calendar.astro';
import ClipboardList from '@components/ui/icons/ClipboardList.astro';
import GraduationCap from '@components/ui/icons/GraduationCap.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import {
  generateAboutPageJSONLD,
  generateBreadcrumbListJSONLD,
} from '@utils/jsonld';

const breadcrumbItems = [
  { name: 'Início', url: '/' },
  { name: 'Sobre', url: '/sobre' },
];

const sobreJsonLd = [
  generateAboutPageJSONLD({
    name: 'Sobre Fernando Serrano Vicentin — Personal Trainer em Maringá',
    description:
      'Fernando Serrano Vicentin, personal trainer em Maringá: 19 anos de experiência, fundador da VicentBOX, especialização USP HC em andamento.',
    url: '/sobre',
  }),
  generateBreadcrumbListJSONLD(breadcrumbItems),
];
---

<Layout
  title="Sobre Fernando Serrano Vicentin | Personal Trainer VicentBOX"
  description="Conheça Fernando Serrano Vicentin, personal trainer em Maringá: 19 anos de experiência, fundador da VicentBOX e especialização USP HC em andamento."
  jsonLd={sobreJsonLd}
  includePerson
>
  <Breadcrumb items={breadcrumbItems} />
  <Hero
    title="Fernando Serrano Vicentin — Personal Trainer em Maringá"
    subtitle="19 anos de experiência com movimento. Foco em saúde aos 40+, com atenção humanizada. Finalizando especialização em Educação Física na Saúde no HC da USP."
    ctaText="Falar com Fernando no WhatsApp"
    ctaHref="https://wa.me/5544999218147?text=Olá! Vim pelo site da VicentBOX. Gostaria de falar com o Fernando."
    ctaTrackSource="hero"
    badge="19 anos de experiência | Especialização USP HC em andamento | Terapia manual 5 min"
    image="/images/sobre-fernando.jpg"
    imageAlt="Fernando Serrano Vicentin, personal trainer da VicentBOX em Maringá"
    stats={[
      { value: '19+', label: 'Anos de experiência' },
      { value: 'USP HC', label: 'Especialização em andamento' },
      { value: '5 min', label: 'Terapia manual/aula' },
    ]}
  />

  <Section id="historia" background="white" aria-labelledby="historia-title">
    <Container>
      <div class="grid lg:grid-cols-2 gap-fluid-10 items-center">
        <div>
          <h2 id="historia-title" class="text-fluid-3xl font-heading font-bold text-neutral-900 mb-6">A história por trás do método</h2>
          <div class="space-y-4 text-fluid-base text-neutral-700 leading-relaxed">
            <p>Comecei há 19 anos como personal trainer. Via pessoas se machucando, desistindo, não conseguindo resultado. A VicentBOX nasceu para mudar isso: atenção humanizada, turmas pequenas e acompanhamento de verdade.</p>
            <p>Estou finalizando a especialização em <strong>Educação Física na Saúde em Ambiente Hospitalar pela Escola de Medicina da USP — Hospital das Clínicas</strong>, o que reforça a forma como prescrevo exercício com segurança e indicação clara.</p>
            <p>Hoje, na VicentBOX, cada aluno passa por avaliação antes de começar, treina em turma reduzida (até 3 no multifuncional) e termina toda aula com 5 minutos de terapia manual. Também contamos com parceria de uma fisioterapeuta osteopata para casos que precisam desse cuidado.</p>
          </div>
        </div>
        <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-neutral-100 border border-neutral-200">
          <img
            src="/images/sobre-fernando.jpg"
            alt="Retrato de Fernando Serrano Vicentin, personal trainer e fundador da VicentBOX"
            width="1200"
            height="800"
            class="w-full h-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </Container>
  </Section>

  <Methodology
    title="Os 3 Pilares da Metodologia VicentBOX"
    subtitle="Como a avaliação e a prescrição funcionam na prática:"
    pillars={[
      {
        icon: 'shield-check',
        title: 'Avaliar Antes de Prescrever',
        desc: 'Ninguém treina sem anamnese, testes de movimento e análise postural. Segurança primeiro.',
        details: ['Anamnese de saúde', 'Testes de movimento', 'Análise postural', 'Definição de objetivos'],
      },
      {
        icon: 'dumbbell',
        title: 'Prescrever para o Indivíduo',
        desc: 'Mesmo em grupo de 3, cada uma faz seu treino. Carga, amplitude, exercício — tudo individualizado.',
        details: ['Ajustes conforme seu progresso', 'Adaptação para restrições e condições', 'Foco em padrões funcionais', 'Respeito ao seu nível atual'],
      },
      {
        icon: 'sparkles',
        title: 'Treinar com Cuidado',
        desc: 'A terapia manual de 5 minutos ao final da aula ajuda no relaxamento e na recuperação muscular.',
        details: ['Terapia manual 5 min ao final de toda aula', 'Atenção humanizada', 'Movimento com acompanhamento', 'Ambiente acolhedor'],
      },
    ]}
  >
    <ShieldCheck slot="shield-check" class="w-6 h-6" />
    <Dumbbell slot="dumbbell" class="w-6 h-6" />
    <Sparkles slot="sparkles" class="w-6 h-6" />
  </Methodology>

  <Section id="formacao" background="neutral-50" aria-labelledby="formacao-title">
    <Container>
      <header class="heading-section">
        <h2 id="formacao-title" class="heading-section-title">Formação e Parcerias</h2>
        <p class="heading-section-subtitle">Credenciais que sustentam a prática</p>
      </header>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <Card class="card-hover p-6">
          <div class="icon-wrapper icon-wrapper-primary mb-4">
            <GraduationCap class="w-6 h-6" />
          </div>
          <h3 class="text-fluid-lg font-heading font-semibold text-neutral-900 mb-2">Educação Física na Saúde — USP HC</h3>
          <p class="text-fluid-base text-neutral-600">Especialização em andamento na Escola de Medicina da USP, Hospital das Clínicas — Educação Física na Saúde em Ambiente Hospitalar.</p>
        </Card>
        <Card class="card-hover p-6">
          <div class="icon-wrapper icon-wrapper-secondary mb-4">
            <HeartPulse class="w-6 h-6" />
          </div>
          <h3 class="text-fluid-lg font-heading font-semibold text-neutral-900 mb-2">19 Anos de Experiência</h3>
          <p class="text-fluid-base text-neutral-600">Atuação com foco em saúde, qualidade de vida e público 40+ — dores, cansaço, fadiga e sobrepeso.</p>
        </Card>
        <Card class="card-hover p-6">
          <div class="icon-wrapper icon-wrapper-accent mb-4">
            <Users class="w-6 h-6" />
          </div>
          <h3 class="text-fluid-lg font-heading font-semibold text-neutral-900 mb-2">Parceria Fisioterapeuta Osteopata</h3>
          <p class="text-fluid-base text-neutral-600">Parceria com uma fisioterapeuta osteopata para cuidado integrado quando necessário.</p>
        </Card>
        <Card class="card-hover p-6">
          <div class="icon-wrapper icon-wrapper-primary mb-4">
            <Target class="w-6 h-6" />
          </div>
          <h3 class="text-fluid-lg font-heading font-semibold text-neutral-900 mb-2">Foco em Saúde aos 40+</h3>
          <p class="text-fluid-base text-neutral-600">Atenção humanizada para mulheres a partir dos 40 e para quem busca qualidade de vida com segurança.</p>
        </Card>
        <Card class="card-hover p-6">
          <div class="icon-wrapper icon-wrapper-secondary mb-4">
            <Calendar class="w-6 h-6" />
          </div>
          <h3 class="text-fluid-lg font-heading font-semibold text-neutral-900 mb-2">Empresa VicentBOX — 3 Anos</h3>
          <p class="text-fluid-base text-neutral-600">Studio em Maringá com treinamento multifuncional, alongamento, grupo de corrida, consultoria online e palestras.</p>
        </Card>
        <Card class="card-hover p-6">
          <div class="icon-wrapper icon-wrapper-accent mb-4">
            <ClipboardList class="w-6 h-6" />
          </div>
          <h3 class="text-fluid-lg font-heading font-semibold text-neutral-900 mb-2">Avaliação Antes de Começar</h3>
          <p class="text-fluid-base text-neutral-600">Toda jornada começa com avaliação para anamnese, testes de movimento e definição de objetivos. Valor informado no agendamento.</p>
        </Card>
      </div>
    </Container>
  </Section>

  <CTA
    title="Quer conversar com o Fernando?"
    subtitle="Tire suas dúvidas, entenda se o método faz sentido para você, agende a avaliação."
    ctaText="Falar no WhatsApp"
    ctaHref="https://wa.me/5544999218147?text=Olá! Vim pelo site da VicentBOX. Gostaria de falar com o Fernando."
    ctaTrackSource="sobre_cta"
    background="primary-600"
  />
</Layout>