---
import Layout from '@layouts/Layout.astro';
import { services } from '@types';
import ServiceCard from '@components/sections/ServiceCard.astro';
import CTA from '@components/sections/CTA.astro';
import Container from '@components/ui/Container.astro';
import Section from '@components/ui/Section.astro';
import Dumbbell from '@components/ui/icons/Dumbbell.astro';
import Running from '@components/ui/icons/Running.astro';
import Smartphone from '@components/ui/icons/Smartphone.astro';
import Target from '@components/ui/icons/Target.astro';
import Sparkles from '@components/ui/icons/Sparkles.astro';
import HeartPulse from '@components/ui/icons/HeartPulse.astro';
import Users from '@components/ui/icons/Users.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import {
  generateBreadcrumbListJSONLD,
  generateServicesItemListJSONLD,
} from '@utils/jsonld';

const breadcrumbItems = [
  { name: 'Início', url: '/' },
  { name: 'Serviços', url: '/servicos' },
];

// Ordem inteligente: mais procurados primeiro, cada serviço aparece 1 única vez
const orderedServices = [...services]
  .filter((s) => s.id !== 'palestras-saude')
  .sort((a, b) => Number(b.priority) - Number(a.priority));
const wideService = services.find((s) => s.id === 'palestras-saude');

const chooser = [
  {
    id: 'dores',
    title: 'Sinto dores e quero acompanhamento de perto',
    desc: 'Treinamento em turmas de até 3, com avaliação inicial e terapia manual em toda aula.',
    serviceName: 'Treinamento Multifuncional',
    href: '/treinamento-multifuncional',
    icon: 'dumbbell',
  },
  {
    id: 'emagrecer',
    title: 'Quero perder peso e voltar a me mexer',
    desc: 'Protocolo de 15 dias com acompanhamento para sair do sedentarismo com segurança.',
    serviceName: 'Desafio 15 Dias',
    href: 'https://wa.me/5544999218147?text=Ol%C3%A1!%20Vim%20pelo%20site%20da%20VicentBOX.%20Tenho%20interesse%20no%20Desafio%2015%20Dias.%20Gostaria%20de%20mais%20informa%C3%A7%C3%B5es.',
    icon: 'target',
  },
  {
    id: 'corrida',
    title: 'Quero correr em grupo, no meu nível',
    desc: 'Corrida de rua 3x/semana presencial ou consultoria online, do iniciante ao experiente.',
    serviceName: 'Grupo de Corrida',
    href: '/grupo-corrida',
    icon: 'running',
  },
  {
    id: 'online',
    title: 'Prefiro treinar onde estiver, no meu ritmo',
    desc: 'Treino personalizado no app por R$ 39,90/mês, com acompanhamento do professor.',
    serviceName: 'Consultoria Online',
    href: '/consultoria-online',
    icon: 'smartphone',
  },
];

const servicesJsonLd = [
  generateBreadcrumbListJSONLD(breadcrumbItems),
  generateServicesItemListJSONLD(),
];
---

<Layout
  title="Serviços VicentBOX em Maringá | Treino, Corrida e Consultoria"
  description="Conheça os 7 serviços da VicentBOX em Maringá: treinamento multifuncional, grupo de corrida, consultoria online, desafio, alongamento e palestras."
  jsonLd={servicesJsonLd}
>
  <Breadcrumb items={breadcrumbItems} />
  <section class="section bg-primary-900" aria-labelledby="servicos-title">
    <Container>
      <header class="heading-section">
        <h1 id="servicos-title" class="heading-section-title">Serviços de Personal Trainer em Maringá</h1>
        <p class="heading-section-subtitle">7 opções para cuidar da sua saúde — presencial em Maringá ou online, a partir de R$ 39,90/mês</p>
      </header>
    </Container>
  </section>

  <!-- Todos os serviços, 1 única vez, ordenados pelos mais procurados -->
  <Section id="servicos-grid" background="white" number="01" aria-labelledby="grid-title">
    <Container>
      <h2 id="grid-title" class="sr-only">Todos os serviços</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {orderedServices.map((service) => (
          <ServiceCard service={service}>
            <Dumbbell slot="dumbbell" class="w-6 h-6" />
            <Running slot="running" class="w-6 h-6" />
            <Smartphone slot="smartphone" class="w-6 h-6" />
            <Target slot="target" class="w-6 h-6" />
            <Sparkles slot="sparkles" class="w-6 h-6" />
            <HeartPulse slot="heart-pulse" class="w-6 h-6" />
            <Users slot="users" class="w-6 h-6" />
          </ServiceCard>
        ))}
      </div>
    </Container>
  </Section>

  <!-- Ajudante de decisão: objetivo → serviço indicado -->
  <Section id="por-onde-comecar" background="neutral-50" number="02" aria-labelledby="chooser-title">
    <Container>
      <header class="heading-section">
        <h2 id="chooser-title" class="heading-section-title">Não sabe por onde começar?</h2>
        <p class="heading-section-subtitle">Diga seu objetivo e veja o formato indicado — ou agende a avaliação inicial no WhatsApp</p>
      </header>
      <div class="grid sm:grid-cols-2 gap-4 max-w-4xl mx-auto">
        {chooser.map((item) => (
          <a
            href={item.href}
            class="card card-hover flex items-start gap-4 p-5 group reveal"
            data-track="chooser_click"
            data-track-source={item.id}
          >
            <div class="icon-wrapper icon-wrapper-primary flex-shrink-0" aria-hidden="true">
              {item.icon === 'dumbbell' && <Dumbbell class="w-6 h-6" />}
              {item.icon === 'target' && <Target class="w-6 h-6" />}
              {item.icon === 'running' && <Running class="w-6 h-6" />}
              {item.icon === 'smartphone' && <Smartphone class="w-6 h-6" />}
            </div>
            <div class="min-w-0">
              <h3 class="font-heading font-semibold text-white group-hover:text-accent-400">{item.title}</h3>
              <p class="text-fluid-sm text-neutral-300 mt-1">{item.desc}</p>
              <p class="text-fluid-sm font-semibold text-accent-400 mt-2">
                {item.serviceName} <span aria-hidden="true">→</span>
              </p>
            </div>
          </a>
        ))}
      </div>
      <p class="text-center text-fluid-sm text-neutral-300 mt-6">
        Na dúvida? A <strong>avaliação inicial</strong> identifica seu quadro e indica o melhor formato para você.
      </p>
    </Container>
  </Section>

  <!-- Destaque de campanha: Desafio 15 Dias -->
  <Section id="desafio-destaque" background="accent-50" number="03" aria-labelledby="desafio-destaque-title">
    <Container>
      <div class="grid md:grid-cols-2 gap-8 items-center max-w-4xl mx-auto">
        <div class="mx-auto w-full max-w-sm">
          <picture>
            <source srcset="/images/promo-desafio-15-dias.webp" type="image/webp" />
            <img
              src="/images/promo-desafio-15-dias.jpg"
              alt="Desafio 15 Dias — VicentBOX"
              width="472"
              height="472"
              class="w-full rounded-xl shadow-card"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
        <div>
          <p class="text-fluid-sm font-medium text-accent-400 uppercase tracking-wide mb-2">Campanha</p>
          <h2 id="desafio-destaque-title" class="text-fluid-2xl font-heading font-bold text-white mb-3">
            Desafio 15 Dias
          </h2>
          <p class="text-fluid-base text-neutral-200 mb-5">
            Protocolo de perda de peso com acompanhamento em 15 dias — para sair do sedentarismo com suporte de verdade.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="https://wa.me/5544999218147?text=Ol%C3%A1!%20Vim%20pelo%20site%20da%20VicentBOX.%20Tenho%20interesse%20no%20Desafio%2015%20Dias.%20Gostaria%20de%20mais%20informa%C3%A7%C3%B5es."
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp"
              data-track="cta_click"
              data-track-source="desafio_banner"
            >
              Quero fazer o desafio
            </a>
            <span class="inline-flex items-center text-fluid-sm font-semibold text-accent-400">Consulte no WhatsApp</span>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- B2B: palestras em card amplo -->
  {wideService && (
    <Section id="para-empresas" background="white" number="04" aria-labelledby="para-empresas-title">
      <Container>
        <p class="text-fluid-sm font-medium text-neutral-400 uppercase tracking-wide mb-3" id="para-empresas-title">
          Para empresas e grupos
        </p>
        <ServiceCard service={wideService} layout="horizontal">
          <Users slot="users" class="w-6 h-6" />
        </ServiceCard>
      </Container>
    </Section>
  )}

  <CTA
    title="Quer uma indicação personalizada?"
    subtitle="Conte seu objetivo no WhatsApp e o Fernando indica o melhor formato para o seu momento."
    ctaText="Falar no WhatsApp"
    ctaHref="https://wa.me/5544999218147?text=Olá! Vim pelo site da VicentBOX. Tenho interesse nos serviços mas preciso de mais informações."
    ctaTrackSource="servicos_cta"
    background="primary-600"
  />
</Layout>
