---
import Layout from '@layouts/Layout.astro';
import { siteConfig, featuresConsultoria, faqConsultoria } from '@types';
import Hero from '@components/sections/Hero.astro';
import Features from '@components/sections/Features.astro';
import Offer from '@components/sections/Offer.astro';
import FAQ from '@components/sections/FAQ.astro';
import CTA from '@components/sections/CTA.astro';
import LeadForm from '@components/forms/LeadForm.astro';
import Container from '@components/ui/Container.astro';
import Section from '@components/ui/Section.astro';
import Smartphone from '@components/ui/icons/Smartphone.astro';
import Video from '@components/ui/icons/Video.astro';
import MapPin from '@components/ui/icons/MapPin.astro';
import MessageCircle from '@components/ui/icons/MessageCircle.astro';
import Users from '@components/ui/icons/Users.astro';
import Dumbbell from '@components/ui/icons/Dumbbell.astro';
import ShieldCheck from '@components/ui/icons/ShieldCheck.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import { generateServiceJSONLD, generateProductJSONLD, generateBreadcrumbListJSONLD, generateFAQPageJSONLD } from '@utils/jsonld';

const breadcrumbItems = [
  { name: 'Início', url: '/' },
  { name: 'Serviços', url: '/servicos' },
  { name: 'Consultoria Online', url: '/consultoria-online' },
];

const service = {
  name: 'Consultoria Online / App',
  description: 'App de consultoria online com treino personalizado adaptado ao local onde você treina, com acompanhamento pelo professor.',
  price: '39.90',
  url: '/consultoria-online',
  image: '/images/consultoria-online.jpg',
};

const product = {
  name: 'Consultoria Online / App VicentBOX',
  description: 'App de consultoria online por R$39,90/mês: treino personalizado no celular, adaptado ao local de treino, com acompanhamento do professor.',
  price: 39.90,
  url: '/consultoria-online',
  image: '/images/consultoria-online.jpg',
};

const serviceJsonLd = generateServiceJSONLD(service);
const productJsonLd = generateProductJSONLD(product);
const breadcrumbJsonLd = generateBreadcrumbListJSONLD(breadcrumbItems);
const faqJsonLd = generateFAQPageJSONLD(faqConsultoria);
---

<Layout
  title="Consultoria Online de Treino | App R$39,90/mês | VicentBOX"
  description="Consultoria online por R$39,90/mês: treino personalizado no celular, onde e quando quiser, com acompanhamento do professor."
  jsonLd={[serviceJsonLd, productJsonLd, breadcrumbJsonLd, faqJsonLd]}
>
  <Breadcrumb items={breadcrumbItems} />
  <Hero
    title="Consultoria Online de Treino Personalizado"
    subtitle="App de consultoria online por R$39,90/mês com treino personalizado no celular e acompanhamento pelo professor."
    ctaText="Começar Agora"
    ctaHref="/consultoria-online#formulario"
    ctaVariant="primary"
    ctaTrackSource="hero"
    badge="R$39,90/mês | Treino personalizado | Acompanhamento do professor"
    image="/images/consultoria-online.jpg"
    imageAlt="Aluna em aula online com o professor — consultoria VicentBOX"
    stats={[
      { value: 'R$ 39,90', label: '/mês' },
      { value: '100%', label: 'Personalizado' },
      { value: 'Onde quiser', label: 'Academia, casa ou parque' },
    ]}
  />

  <Features
    title="O que você recebe na consultoria online"
    subtitle="Treino personalizado com acompanhamento de verdade:"
    features={featuresConsultoria}
  >
    <Video slot="video" class="w-6 h-6" />
    <MapPin slot="map-pin" class="w-6 h-6" />
    <MessageCircle slot="message-circle" class="w-6 h-6" />
    <Users slot="users" class="w-6 h-6" />
    <Dumbbell slot="dumbbell" class="w-6 h-6" />
    <ShieldCheck slot="shield" class="w-6 h-6" />
  </Features>

  <Offer
    title="Simples e transparente"
    subtitle="Um plano, tudo incluso:"
    plans={[
      {
        name: 'Consultoria Online Completa',
        price: 'R$ 39,90',
        period: '/mês',
        features: [
          'Treino personalizado no celular',
          'Para academia, casa, hotel ou parque',
          'Acompanhamento do professor',
          'Onde e quando você quiser',
          'Atendimento online além do presencial',
          'Assinatura mensal de R$ 39,90',
        ],
        ctaText: 'Começar minha consultoria',
        ctaHref: '#formulario',
        ctaVariant: 'primary',
        popular: true,
      },
    ]}
  />

  <FAQ
    title="Dúvidas frequentes sobre a Consultoria Online"
    faqs={faqConsultoria}
  />

  <section id="formulario" class="section bg-white" aria-labelledby="form-title">
    <Container>
      <LeadForm
        source="consultoria"
        title="Comece sua consultoria hoje"
        subtitle="Preencha o formulário e entraremos em contato para montar seu treino personalizado."
        submitText="Quero começar por E-mail"
        fields={['name', 'email', 'phone', 'objective', 'injuries']}
        successMessage="Recebemos seus dados. Em breve entramos em contato para continuar."
      />
    </Container>
  </section>

  <Section id="relacionados" background="neutral-50" aria-labelledby="relacionados-title">
    <Container>
      <header class="heading-section">
        <h2 id="relacionados-title" class="heading-section-title">Outros serviços da VicentBOX</h2>
        <p class="heading-section-subtitle">Prefere treinar presencial em Maringá? Veja também:</p>
      </header>
      <ul class="grid sm:grid-cols-3 gap-4 text-fluid-sm">
        <li class="card">
          <a href="/treinamento-multifuncional" class="font-semibold text-primary-700 hover:underline">Treinamento Multifuncional</a>
          <p class="text-neutral-600 mt-1">Turmas de até 3 com terapia manual ao final da aula.</p>
        </li>
        <li class="card">
          <a href="/grupo-corrida" class="font-semibold text-primary-700 hover:underline">Grupo de Corrida</a>
          <p class="text-neutral-600 mt-1">Corrida de rua presencial ou online em Maringá.</p>
        </li>
        <li class="card">
          <a href="/servicos" class="font-semibold text-primary-700 hover:underline">Todos os serviços</a>
          <p class="text-neutral-600 mt-1">Alongamento, relaxamento, desafio 15 dias e palestras.</p>
        </li>
      </ul>
    </Container>
  </Section>

  <CTA
    title="Prefere falar no WhatsApp antes de decidir?"
    subtitle="Sem problema. Tire suas dúvidas direto com a gente."
    ctaText="Falar no WhatsApp"
    ctaHref="https://wa.me/5544999218147?text=Olá! Vim pelo site da VicentBOX. Tenho dúvidas sobre a Consultoria Online."
    ctaTrackSource="final_cta"
    background="primary-600"
  />
</Layout>