---
import Layout from '@layouts/Layout.astro';
import { services, faqHome, problemsTreinamento, benefitsTreinamento } from '@types';
import Hero from '@components/sections/Hero.astro';
import Marquee from '@components/sections/Marquee.astro';
import Problems from '@components/sections/Problems.astro';
import ValueProps from '@components/sections/ValueProps.astro';
import Quote from '@components/sections/Quote.astro';
import ServiceCard from '@components/sections/ServiceCard.astro';
import SocialProof from '@components/sections/SocialProof.astro';
import PhotoGallery from '@components/sections/PhotoGallery.astro';
import CtaHub from '@components/sections/CtaHub.astro';
import CTA from '@components/sections/CTA.astro';
import FAQ from '@components/sections/FAQ.astro';
import Dumbbell from '@components/ui/icons/Dumbbell.astro';
import Running from '@components/ui/icons/Running.astro';
import Smartphone from '@components/ui/icons/Smartphone.astro';
import HeartPulse from '@components/ui/icons/HeartPulse.astro';
import Sparkles from '@components/ui/icons/Sparkles.astro';
import ShieldCheck from '@components/ui/icons/ShieldCheck.astro';
import Users from '@components/ui/icons/Users.astro';
import CheckCircle from '@components/ui/icons/CheckCircle.astro';
import Container from '@components/ui/Container.astro';
import Section from '@components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import {
  generateBreadcrumbListJSONLD,
  generateHomeReviewsJSONLD,
  generateFAQPageJSONLD,
} from '@utils/jsonld';

const waAvaliacao = 'https://wa.me/5544999218147?text=Olá! Vim pelo site da VicentBOX. Quero agendar uma avaliação com o personal trainer.';
const benefitIcons: Record<string, any> = {
  'shield-check': ShieldCheck,
  posture: Sparkles,
  dumbbell: Dumbbell,
  'user-check': Users,
  users: Users,
  'heart-pulse': HeartPulse,
};

const homeJsonLd = [
  generateBreadcrumbListJSONLD([{ name: 'Início', url: '/' }]),
  generateFAQPageJSONLD(faqHome),
  ...generateHomeReviewsJSONLD(),
];
---

<Layout
  title="Personal Trainer em Maringá | Saia das Dores e Cuide da Saúde 40+"
  description="Personal trainer em Maringá para dores, cansaço, fadiga e sobrepeso aos 40+. Turmas de até 3, terapia manual 5 min, 19 anos. Agende pelo WhatsApp."
  jsonLd={homeJsonLd}
  includePerson
>
  <!-- PAS · Hero: Problema + alívio imediato + solução -->
  <Hero
    title="Personal Trainer em Maringá para sair das dores e voltar a se movimentar"
    highlight="sair das dores"
    subtitle="Dores no corpo, cansaço, fadiga e sobrepeso derrubam sua energia e a vontade de ser ativa de novo. Aqui você treina em turmas de até 3 pessoas, com terapia manual ao final de toda aula e acompanhamento de perto — feito para mulheres 40+ que querem cuidar da saúde com segurança."
    ctaText="Falar no WhatsApp"
    ctaHref={waAvaliacao}
    ctaVariant="whatsapp"
    ctaTrackSource="hero"
    badge="Studio em Maringá/PR | 19 anos de experiência | Especialização USP HC em andamento"
    image="/images/hero-personal-trainer.jpg"
    imageAlt="Personal trainer acompanhando aluna em exercício com faixa elástica no studio VicentBOX"
    visualChips={["Turma de até 3", "Terapia manual 5 min"]}
    stats={[
      { value: '19+', label: 'Anos de experiência' },
      { value: '3', label: 'Alunos por turma (máx.)' },
      { value: '5 min', label: 'Terapia manual/aula' },
    ]}
  />

  <!-- Fita rolante: pilares do método em movimento -->
  <Marquee
    items={[
      'Avaliação grátis',
      'Turmas de até 3 pessoas',
      'Terapia manual em toda aula',
      '19 anos de experiência',
      'Maringá/PR',
      'Projeto social Sports Tea',
      'Especialização USP HC em andamento',
      'Mulheres 40+',
    ]}
  />

  <!-- PAS · Agitação: espelha as dores reais do público -->
  <Problems
    number="01"
    title="Se você se reconhece aqui, não está sozinha"
    subtitle="São exatamente os problemas que mais chegam até a VicentBOX — e o ponto de partida do nosso trabalho"
    problems={[
      'Dores no corpo que limitam o seu dia a dia',
      'Cansaço e fadiga que derrubam sua energia',
      'Sobrepeso ou obesidade sem rumo definido',
      'Não se sente bem com o próprio corpo',
      'Quer voltar a ser ativa, mas não sabe por onde começar',
      'Sedentarismo e medo de se machucar ao tentar voltar a treinar',
    ]}
  />

  <!-- Bloco dos 5 CTAs (caminhos do cliente) logo após a agitação -->
  <CtaHub number="02" />

  <!-- PAS · Solução + mecanismo -->
  <ValueProps number="03">
    <HeartPulse slot="heart-pulse" class="w-6 h-6" />
    <Sparkles slot="sparkles" class="w-6 h-6" />
    <ShieldCheck slot="shield-check" class="w-6 h-6" />
  </ValueProps>

  <!-- Fala central do método -->
  <Quote
    quote="Treino de verdade depois dos 40 não é sobre aparecer — é sobre **voltar a se movimentar** com segurança e sem dor."
  />

  <!-- PAS · Desejo: o que muda no dia a dia -->
  <Section id="beneficios" background="neutral-50" number="04" aria-labelledby="beneficios-title">
    <Container>
      <header class="heading-section">
        <h2 id="beneficios-title" class="heading-section-title">O que muda quando o treino é feito para você</h2>
        <p class="heading-section-subtitle">Benefícios do método VicentBOX para quem busca saúde, mobilidade e acompanhamento de verdade</p>
      </header>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {benefitsTreinamento.map((benefit, i) => {
          const Icon = benefitIcons[benefit.icon] || CheckCircle;
          return (
            <Card key={i} class="card-hover p-6 h-full reveal">
              <div class="flex items-start gap-4">
                {benefit.image ? (
                  <div class="icon-wrapper overflow-hidden p-0 flex-shrink-0" aria-hidden="true">
                    <img
                      src={benefit.image}
                      alt=""
                      width="44"
                      height="44"
                      class="w-full h-full object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                ) : (
                  <div class="icon-wrapper icon-wrapper-primary flex-shrink-0" aria-hidden="true">
                    <Icon class="w-6 h-6" />
                  </div>
                )}
                <div>
                  <h3 class="font-heading font-semibold text-white mb-1">{benefit.title}</h3>
                  <p class="text-fluid-base text-neutral-300">{benefit.desc}</p>
                </div>
              </div>
            </Card>
          );
        })}
      </div>
      <div class="text-center mt-8">
        <a href={waAvaliacao} class="btn btn-whatsapp" data-track="cta_click" data-track-source="after_benefits">
          Quero começar pelo WhatsApp
        </a>
      </div>
    </Container>
  </Section>

  <!-- Oferta / caminhos (AIDA micro: interesse → ação) -->
  <section id="servicos-destaque" class="section bg-primary-950" aria-labelledby="servicos-title">
    <span class="section-num" aria-hidden="true">05</span>
    <Container class="px-4 sm:px-6 lg:px-8">
      <header class="heading-section">
        <h2 id="servicos-title" class="heading-section-title">Escolha o caminho da sua avaliação</h2>
        <p class="heading-section-subtitle">Comece pela sessão que resolve o que te traz aqui — treino presencial, corrida ou consultoria online</p>
      </header>
      <div class="grid md:grid-cols-3 gap-6">
        {services.filter(s => s.priority).map((service, i) => (
          <ServiceCard key={i} service={service}>
            <Dumbbell slot="dumbbell" class="w-6 h-6" />
            <Running slot="running" class="w-6 h-6" />
            <Smartphone slot="smartphone" class="w-6 h-6" />
          </ServiceCard>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/servicos" class="btn btn-outline" data-track="cta_click" data-track-source="ver_todos_servicos">
          Ver todos os serviços →
        </a>
      </div>
    </Container>
  </section>

  <!-- Prova social mais cedo no funil -->
  <SocialProof
    number="06"
    title="Quem já treina aqui avalia no Google"
    subtitle="Avaliações reais de quem buscou saúde e acompanhamento com a VicentBOX"
    testimonials={[
      {
        name: 'roseli oliveira cordeiro',
        role: 'Avaliação no Google · há 10 meses',
        content:
          'Experiência incrível organização respeito equidade excelente profissional de educação física cujo nome é Fernando vc está de parabéns. Muito obrigada por sua dedicação a todos os participantes',
        rating: 5,
      },
      {
        name: 'Anita Naka',
        role: 'Avaliação no Google · há 10 meses',
        content:
          'Muito bom profissional, atencioso. E ajudando na saude fisica e mental! Recomendo 100%',
        rating: 5,
      },
      {
        name: 'Carolina Siqueira',
        role: 'Avaliação no Google · há 10 meses',
        content:
          'Muito boa, professor atencioso e preocupado com a saúde dos alunos, em especial a minha por ser diabética.',
        rating: 5,
      },
    ]}
  />

  <!-- Fotos dos treinos e do studio -->
  <PhotoGallery number="07" />

  <FAQ
    number="08"
    title="Dúvidas frequentes antes de agendar"
    subtitle="Preços, horários, avaliação e para quem é o método"
    faqs={faqHome}
  />

  <!-- PAS · Fechamento: alívio + ação única -->
  <CTA
    title="Chega de conviver com a dor no piloto automático"
    subtitle="Agende sua avaliação pelo WhatsApp. Você conversa direto com a gente, tira suas dúvidas e recebe um plano de ação claro para os seus objetivos de saúde."
    ctaText="Agendar avaliação no WhatsApp"
    ctaHref={waAvaliacao}
    ctaTrackSource="final_cta"
    background="primary-600"
  />
</Layout>
