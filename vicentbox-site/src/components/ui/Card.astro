---
interface Props {
  children: any;
  class?: string;
  hover?: boolean;
  padding?: 'none' | 'sm' | 'md' | 'lg';
}

const {
  children,
  class: className = '',
  hover = false,
  padding = 'md',
} = Astro.props;

const paddingClasses = {
  none: '',
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8',
};

const classes = `card ${hover ? 'card-hover' : ''} ${paddingClasses[padding]} ${className}`;
---

<div class={classes}>
  <slot>{children}</slot>
</div>