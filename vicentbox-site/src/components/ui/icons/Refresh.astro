---
interface Props {
  class?: string;
  'aria-hidden'?: boolean;
}
const { class: className = 'w-6 h-6', 'aria-hidden': ariaHidden = true, ...attrs } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={ariaHidden}
  {...attrs}
>
  <path d="M21 12a9 9 0 1 1-6.219-8.56" />
</svg>