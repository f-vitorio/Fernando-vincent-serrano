---
interface Props {
  class?: string;
  'aria-hidden'?: boolean;
}
const { class: className = 'w-6 h-6', 'aria-hidden': ariaHidden = true, ...attrs } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={ariaHidden}
  {...attrs}
>
  <path d="M13 4v6l3.5 3.5" />
  <path d="M11.5 22 9 19.5l2-4L7 12l4.5-4.5L13 4" />
  <circle cx="15" cy="4" r="1" />
</svg>