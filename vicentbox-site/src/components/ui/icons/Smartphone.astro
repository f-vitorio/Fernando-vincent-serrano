---
interface Props {
  class?: string;
  'aria-hidden'?: boolean;
}
const { class: className = 'w-6 h-6', 'aria-hidden': ariaHidden = true, ...attrs } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={ariaHidden}
  {...attrs}
>
  <rect x="2" y="3" width="20" height="14" rx="2" />
  <path d="M8 21h8" />
  <path d="M12 17v4" />
</svg>