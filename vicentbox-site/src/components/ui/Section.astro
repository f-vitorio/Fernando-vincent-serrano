---
interface Props {
  children: any;
  class?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  background?: 'white' | 'neutral-50' | 'primary-50' | 'secondary-50' | 'accent-50' | 'neutral-900' | 'primary-600' | 'primary-700' | 'primary-900';
  id?: string;
  ariaLabel?: string;
  'aria-labelledby'?: string;
}

const {
  children,
  class: className = '',
  size = 'md',
  background = 'white',
  id,
  ariaLabel,
  'aria-labelledby': ariaLabelledby,
} = Astro.props;

const sizeClasses = {
  sm: 'section-sm',
  md: 'section',
  lg: 'section md:py-fluid-20',
  xl: 'section md:py-fluid-24',
};

const backgroundClasses = {
  white: 'bg-white',
  'neutral-50': 'bg-neutral-50',
  'primary-50': 'bg-primary-50',
  'secondary-50': 'bg-secondary-50',
  'accent-50': 'bg-accent-50',
  'neutral-900': 'bg-neutral-900 text-neutral-100',
  'primary-600': 'bg-primary-700 text-white [&_p]:text-primary-50 [&_.heading-section-subtitle]:text-primary-100',
  'primary-700': 'bg-primary-800 text-white [&_p]:text-primary-50 [&_.heading-section-subtitle]:text-primary-100',
  'primary-900': 'bg-primary-900 text-neutral-100',
};

const classes = `${sizeClasses[size]} ${backgroundClasses[background]} ${className}`;
---

<section
  id={id}
  class={classes}
  aria-label={ariaLabel}
  aria-labelledby={ariaLabelledby}
>
  <slot>{children}</slot>
</section>
