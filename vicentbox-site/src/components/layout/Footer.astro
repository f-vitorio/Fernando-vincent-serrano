---
import { siteConfig } from '../../types';
import Container from '../ui/Container.astro';
import Instagram from '../ui/icons/Instagram.astro';
import Facebook from '../ui/icons/Facebook.astro';
import TikTok from '../ui/icons/TikTok.astro';
import YouTube from '../ui/icons/YouTube.astro';
import MapPin from '../ui/icons/MapPin.astro';
import Phone from '../ui/icons/Phone.astro';
import Mail from '../ui/icons/Mail.astro';
import Clock from '../ui/icons/Clock.astro';

const serviceLinks = [
  { href: '/treinamento-multifuncional', label: 'Treinamento Multifuncional' },
  { href: '/grupo-corrida', label: 'Grupo de Corrida' },
  { href: '/consultoria-online', label: 'Consultoria Online / App' },
  { href: '/servicos', label: 'Todos os serviços' },
];

const navLinks = [
  { href: '/sobre', label: 'Sobre o Fernando' },
  { href: '/studio', label: 'Studio em Maringá' },
  { href: '/contato', label: 'Contato' },
];

const socials = [
  { href: siteConfig.social.instagram, label: 'Instagram', Icon: Instagram },
  { href: siteConfig.social.facebook, label: 'Facebook', Icon: Facebook },
  { href: siteConfig.social.tiktok, label: 'TikTok', Icon: TikTok },
  { href: siteConfig.social.youtube, label: 'YouTube', Icon: YouTube },
];
---

<footer class="bg-primary-900 text-neutral-300 border-t-2 border-accent-400" role="contentinfo">
  <div class="container-custom py-fluid-12 md:py-fluid-16">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-3 lg:gap-12">
      <!-- Coluna 1: marca + CTA + redes -->
      <div class="lg:pr-4">
        <a href="/" class="inline-flex items-center gap-2 mb-4" aria-label={`${siteConfig.name} - Início`}>
          <span class="font-heading font-bold text-2xl text-white">Vicent<span class="text-accent-400">BOX</span></span>
        </a>
        <p class="text-fluid-sm text-neutral-400 leading-relaxed mb-5 max-w-sm">
          Personal trainer em Maringá para saúde e qualidade de vida aos 40+.
          Fernando Serrano Vicentin — 19 anos de experiência; empresa VicentBOX com 3 anos. Especialização em Educação Física na Saúde (USP HC) em andamento.
        </p>

        <a
          href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Olá! Vim pelo site da VicentBOX. Gostaria de agendar uma avaliação.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-[#15803d] text-white text-fluid-sm font-medium hover:bg-[#166534] transition-colors duration-fast focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#15803d] focus-visible:ring-offset-2 focus-visible:ring-offset-primary-900"
          data-track="whatsapp_click"
          data-track-source="footer"
        >
          <Phone class="w-4 h-4" aria-hidden="true" />
          Agendar avaliação
        </a>

        <div class="flex items-center gap-3 mt-6">
          {socials.map(({ href, label, Icon }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={label}
              class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-white/10 text-neutral-400 hover:bg-white/20 hover:text-white transition-colors duration-fast focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
            >
              <Icon class="w-5 h-5" />
            </a>
          ))}
        </div>

        <a
          href={siteConfig.googleBusinessProfile}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex items-center gap-2 text-fluid-sm text-neutral-400 hover:text-white transition-colors duration-fast focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded"
          data-track="cta_click"
          data-track-source="footer_gbp"
        >
          <MapPin class="w-4 h-4 text-primary-400" aria-hidden="true" />
          Perfil no Google Business
        </a>
      </div>

      <!-- Coluna 2: navegação -->
      <div class="lg:px-4">
        <h3 class="text-fluid-sm font-heading font-semibold uppercase tracking-wider text-neutral-400 mb-4">Navegação</h3>
        <nav aria-label="Serviços" class="mb-6">
          <ul class="space-y-2.5">
            {serviceLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-fluid-sm text-neutral-300 hover:text-white transition-colors duration-fast focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <nav aria-label="Institucional">
          <ul class="space-y-2.5">
            {navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-fluid-sm text-neutral-300 hover:text-white transition-colors duration-fast focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Coluna 3: contato (NAP) -->
      <div class="lg:pl-4">
        <h3 class="text-fluid-sm font-heading font-semibold uppercase tracking-wider text-neutral-400 mb-4">Contato</h3>
        <address class="not-italic space-y-3.5 text-fluid-sm">
          <a
            href={siteConfig.googleBusinessProfile}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-start gap-3 text-neutral-300 hover:text-white transition-colors duration-fast focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded"
            data-track="cta_click"
            data-track-source="footer_maps"
          >
            <MapPin class="w-4 h-4 text-primary-400 flex-shrink-0 mt-0.5" aria-hidden="true" />
            <span>
              {siteConfig.address.street}<br />
              {siteConfig.address.neighborhood}<br />
              {siteConfig.address.city} — {siteConfig.address.state}
            </span>
          </a>

          <a
            href={`https://wa.me/${siteConfig.whatsappNumber}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 text-neutral-300 hover:text-white transition-colors duration-fast focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded"
            data-track="whatsapp_click"
            data-track-source="footer_phone"
          >
            <Phone class="w-4 h-4 text-primary-400 flex-shrink-0" aria-hidden="true" />
            <span>{siteConfig.phoneFormatted}</span>
          </a>

          <a
            href={`mailto:${siteConfig.email}`}
            class="flex items-center gap-3 text-neutral-300 hover:text-white transition-colors duration-fast focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded break-all"
          >
            <Mail class="w-4 h-4 text-primary-400 flex-shrink-0" aria-hidden="true" />
            <span>{siteConfig.email}</span>
          </a>

          <div class="flex items-start gap-3 text-neutral-300">
            <Clock class="w-4 h-4 text-primary-400 flex-shrink-0 mt-0.5" aria-hidden="true" />
            <div>
              <p class="text-neutral-300">{siteConfig.businessHours.weekdays}</p>
              <p class="text-neutral-300">{siteConfig.businessHours.weekdaysAlt}</p>
              <p class="text-neutral-400">Demais dias: sob consulta</p>
            </div>
          </div>
        </address>
      </div>
    </div>

    <!-- Marcas & projetos do grupo -->
    <div class="mt-10 pt-6 border-t border-white/10">
      <h3 class="text-fluid-xs font-heading font-semibold uppercase tracking-wider text-neutral-400 mb-4">Marcas & projetos</h3>
      <ul class="flex flex-wrap gap-3" role="list">
        {[
          { image: '/images/logo-vicentbox-cast.jpg', alt: 'VicentBOX Cast' },
          { image: '/images/logo-sports-tea.jpg', alt: 'Sports tea' },
          { image: '/images/logo-conexao-vitalidade.jpg', alt: 'Conexão Vitalidade' },
        ].map((brand) => (
          <li key={brand.image}>
            <picture class="block w-20 h-20 sm:w-24 sm:h-24 rounded-lg overflow-hidden border border-white/10">
              <source srcset={brand.image.replace(/\.jpg$/, '.webp')} type="image/webp" />
              <img
                src={brand.image}
                alt={brand.alt}
                width="96"
                height="96"
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </picture>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-6 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-fluid-xs text-neutral-400">
        © {new Date().getFullYear()} {siteConfig.name} — Maringá/PR. Todos os direitos reservados.
      </p>
      <p class="text-fluid-xs text-neutral-400">
        {siteConfig.address.full}
      </p>
    </div>
  </div>
</footer>
