---
import { siteConfig } from '../../types';
---

<a
  href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Olá! Vim pelo site da VicentBOX. Gostaria de agendar uma avaliação.')}`}
  target="_blank"
  rel="noopener noreferrer"
  class="group fixed bottom-5 right-5 z-50 md:bottom-6 md:right-6"
  aria-label="Falar no WhatsApp"
  data-whatsapp-float
  data-track="whatsapp_click"
  data-track-source="float"
>
  <span
    class="absolute bottom-full right-0 mb-2.5 px-3 py-1.5 bg-neutral-900 text-white text-fluid-xs font-medium rounded-lg shadow-lg whitespace-nowrap opacity-0 invisible translate-y-1 transition-all duration-fast group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 pointer-events-none"
    aria-hidden="true"
  >
    Falar no WhatsApp
  </span>
  <span
    class="flex items-center justify-center gap-2 px-4 py-3.5 md:px-5 md:py-3 rounded-full bg-[#15803d] text-white shadow-lg hover:bg-[#166534] active:bg-[#14532d] transition-all duration-fast"
  >
    <svg class="w-6 h-6 md:w-5 md:h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.471.099-.173.05-.372-.025-.521-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.372-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347-.297-.149-1.005-.463-2.536-1.905-2.5-.225-.374-.248-.449-.3-.522zm-6.871-7.247c-.712 0-1.36.588-1.36 1.313 0 .726.587 1.313 1.36 1.313.712 0 1.36-.587 1.36-1.313 0-.725-.648-1.313-1.36-1.313zm0 2.08c-.427 0-.774-.347-.774-.774 0-.427.347-.774.774-.774.427 0 .774.347.774.774 0 .427-.347.774-.774.774z"/>
    </svg>
    <span class="hidden md:inline ml-2 text-fluid-sm font-semibold">WhatsApp</span>
  </span>
</a>
