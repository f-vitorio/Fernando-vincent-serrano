---
import { siteConfig } from '../../types';
---

<script>
  // Track WhatsApp float clicks
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-whatsapp-float]');
    if (btn && window.trackWhatsAppClick) {
      window.trackWhatsAppClick('float');
    }
  });
</script>

<a
  href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Olá! Vim pelo site da VicentBOX. Gostaria de agendar uma avaliação gratuita.')}`}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-6 right-6 z-50 md:hidden"
  aria-label="Falar no WhatsApp"
  data-whatsapp-float
>
  <button
    class="flex items-center justify-center w-14 h-14 rounded-full bg-green-600 text-white shadow-lg hover:bg-green-700 active:bg-green-800 transition-all duration-fast focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-500 focus-visible:ring-offset-2"
    aria-label="Abrir WhatsApp"
  >
    <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.471.099-.173.05-.372-.025-.521-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.372-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347-.297-.149-1.005-.463-2.536-1.905-2.5-.225-.374-.248-.449-.3-.522zm-6.871-7.247c-.712 0-1.36.588-1.36 1.313 0 .726.587 1.313 1.36 1.313.712 0 1.36-.587 1.36-1.313 0-.725-.648-1.313-1.36-1.313zm0 2.08c-.427 0-.774-.347-.774-.774 0-.427.347-.774.774-.774.427 0 .774.347.774.774 0 .427-.347.774-.774.774z"/>
    </svg>
  </button>

  <span class="absolute bottom-full right-0 mb-2 px-3 py-1.5 bg-neutral-900 text-white text-fluid-sm rounded-lg shadow-lg whitespace-nowrap opacity-0 invisible transition-all duration-fast group-hover:opacity-100 group-hover:visible group-hover:mb-3">
    Falar no WhatsApp
  </span>
</a>

<style>
  @media (min-width: 768px) {
    .md\:hidden {
      display: none;
    }
  }
</style>