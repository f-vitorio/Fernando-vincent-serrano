---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import Star from '../ui/icons/Star.astro';
import { siteConfig } from '../../types';

interface Props {
  title?: string;
  subtitle?: string;
  testimonials?: Array<{ name: string; role?: string; content: string; avatar?: string; result?: string; rating?: number }>;
  showGbpLink?: boolean;
  number?: string;
  class?: string;
}

const {
  title = 'Conheça a VicentBOX no Google',
  subtitle = 'Avaliações e fotos no perfil oficial do Google Business',
  testimonials = [],
  showGbpLink = true,
  number,
  class: className = '',
} = Astro.props;

const hasTestimonials = testimonials.length > 0;
const showSection = hasTestimonials || showGbpLink;
---

{showSection && (
  <Section id="depoimentos" background="neutral-50" number={number} class={className} aria-labelledby="social-proof-title">
    <Container>
      <header class="heading-section">
        <h2 id="social-proof-title" class="heading-section-title">{title}</h2>
        {subtitle && <p class="heading-section-subtitle">{subtitle}</p>}
      </header>

      {hasTestimonials && (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {testimonials.map((testimonial, i) => (
          <Card key={i} class="card-hover p-6 flex flex-col reveal">
            <div class="flex items-center gap-1 text-accent-400 mb-3" aria-label="5 de 5 estrelas">
              {Array.from({ length: testimonial.rating ?? 5 }).map(() => (
                <Star class="w-4 h-4" />
              ))}
            </div>
            {testimonial.result && (
              <div class="badge badge-secondary mb-3 self-start">{testimonial.result}</div>
            )}
            <p class="text-fluid-base text-neutral-200 mb-4 leading-relaxed flex-1">
              &ldquo;{testimonial.content}&rdquo;
            </p>
            <div class="flex items-center gap-3 pt-4 border-t border-white/10 mt-auto">
              <div
                class="w-10 h-10 rounded-full bg-accent-400 text-primary-950 font-heading font-semibold text-fluid-sm flex items-center justify-center flex-shrink-0"
                aria-hidden="true"
              >
                {testimonial.name.charAt(0)}
              </div>
              <div>
                <p class="font-medium text-white">{testimonial.name}</p>
                {testimonial.role && <p class="text-fluid-sm text-neutral-400">{testimonial.role}</p>}
              </div>
            </div>
          </Card>
        ))}
        </div>
      )}

      {showGbpLink && (
        <div class={hasTestimonials ? 'mt-8 text-center' : 'text-center'}>
          <p class="text-fluid-sm text-neutral-300 mb-3">
            Avaliações de quem já treinou com a gente no perfil oficial do Google
          </p>
          <a
            href={siteConfig.googleBusinessProfile}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
            data-track="cta_click"
            data-track-source="gbp_reviews"
          >
            Ver no Google Business Profile
          </a>
        </div>
      )}
    </Container>
  </Section>
)}
