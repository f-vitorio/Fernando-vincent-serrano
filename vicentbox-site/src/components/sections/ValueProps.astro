---
import { siteConfig } from '../../types';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import ShieldCheck from '../ui/icons/ShieldCheck.astro';
import HeartPulse from '../ui/icons/HeartPulse.astro';
import Sparkles from '../ui/icons/Sparkles.astro';

interface Props {
  number?: string;
  class?: string;
}

const { number, class: className = '' } = Astro.props;

const valueProps = [
  {
    icon: 'heart-pulse',
    title: 'Atenção Humanizada',
    desc: 'Turmas de até 3 pessoas com acompanhamento próximo: o personal trainer conhece seu nome, sua dor e seu objetivo — você não é mais um número.',
  },
  {
    icon: 'sparkles',
    title: 'Terapia Manual ao Final da Aula',
    desc: 'Toda aula é finalizada com 5 minutos de terapia manual, conforme o diferencial da VicentBOX.',
  },
  {
    icon: 'shield-check',
    title: 'Especialização USP HC em Andamento',
    desc: 'Fernando está finalizando a especialização em Educação Física na Saúde em Ambiente Hospitalar pela Escola de Medicina da USP — Hospital das Clínicas.',
  },
];
---

<Section id="diferenciais" number={number} class={className} aria-labelledby="value-props-title">
  <Container>
    <header class="heading-section">
      <h2 id="value-props-title" class="heading-section-title">A solução para treinar sem se machucar e sem virar mais um número</h2>
      <p class="heading-section-subtitle">O mecanismo da VicentBOX: atenção de perto, terapia manual e formação voltada à saúde</p>
    </header>

    <div class="grid md:grid-cols-3 gap-6 items-stretch">
      {valueProps.map((prop, i) => (
        <Card key={i} class="card-hover p-6 flex flex-col h-full text-center reveal">
          <div class="icon-wrapper icon-wrapper-primary mx-auto mb-4" aria-hidden="true">
            <slot name={prop.icon} />
          </div>
          <h3 class="text-fluid-lg font-heading font-semibold text-white mb-2">{prop.title}</h3>
          <p class="text-fluid-base text-neutral-300">{prop.desc}</p>
        </Card>
      ))}
    </div>
  </Container>
</Section>