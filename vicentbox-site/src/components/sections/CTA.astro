---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';

interface Props {
  title?: string;
  subtitle?: string;
  ctaText: string;
  ctaHref: string;
  ctaVariant?: 'primary' | 'secondary' | 'whatsapp' | 'outline';
  ctaTrackSource?: string;
  background?: 'white' | 'primary-50' | 'secondary-50' | 'accent-50' | 'primary-600' | 'primary-700';
  class?: string;
}

const {
  title = 'Pronto para começar?',
  subtitle = 'Agende sua avaliação e venha conhecer o método da VicentBOX em Maringá.',
  ctaText,
  ctaHref,
  ctaVariant = 'whatsapp',
  ctaTrackSource = 'cta',
  background = 'primary-600',
  class: className = '',
} = Astro.props;

const isDark = background === 'primary-600' || background === 'primary-700';
const variant = isDark && ctaVariant === 'outline' ? 'primary' : ctaVariant;
---

<Section background={background} class={className} aria-labelledby="cta-title">
  <Container class="text-center">
    <h2 id="cta-title" class="text-fluid-2xl md:text-fluid-3xl font-heading font-bold mb-3 text-balance">{title}</h2>
    {subtitle && <p class="text-fluid-base md:text-fluid-lg mb-7 max-w-2xl mx-auto opacity-90">{subtitle}</p>}
    <Button
      href={ctaHref}
      variant={variant}
      size="lg"
      data-track="cta_click"
      data-track-source={ctaTrackSource}
    >
      {ctaText}
    </Button>
  </Container>
</Section>
