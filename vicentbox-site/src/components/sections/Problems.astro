---
import { siteConfig } from '../../types';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import XCircle from '../ui/icons/XCircle.astro';

interface Props {
  title?: string;
  subtitle?: string;
  problems: string[];
  number?: string;
  class?: string;
}

const { title = 'Os problemas que impedem seu progresso', subtitle, problems, number, class: className = '' } = Astro.props;
---

<Section id="problemas" background="neutral-50" number={number} class={className} aria-labelledby="problems-title">
  <Container>
    <header class="heading-section">
      <h2 id="problems-title" class="heading-section-title">{title}</h2>
      {subtitle && <p class="heading-section-subtitle">{subtitle}</p>}
    </header>

    <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" role="list">
      {problems.map((problem, i) => (
        <li key={i} class="flex items-start gap-4 p-6 bg-white/5 rounded-xl border border-white/10 hover:shadow-card-hover transition-shadow duration-normal reveal" role="listitem">
          <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-accent-400 text-primary-950 flex items-center justify-center" aria-hidden="true">
            <XCircle class="w-6 h-6" />
          </div>
          <p class="text-fluid-base font-medium text-white leading-relaxed">{problem}</p>
        </li>
      ))}
    </ul>
  </Container>
</Section>