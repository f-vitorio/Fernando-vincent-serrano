---
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';

interface Props {
  title: string;
  subtitle?: string;
  ctaText: string;
  ctaHref: string;
  ctaVariant?: 'primary' | 'secondary' | 'whatsapp' | 'outline';
  ctaTrackSource?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  class?: string;
  badge?: string;
  image?: string;
  imageAlt?: string;
  visualChips?: [string, string];
  stats?: Array<{ value: string; label: string }>;
}

const {
  title,
  subtitle,
  ctaText,
  ctaHref,
  ctaVariant = 'whatsapp',
  ctaTrackSource = 'hero',
  secondaryCtaText,
  secondaryCtaHref,
  class: className = '',
  badge,
  image,
  imageAlt,
  visualChips = ['Avaliação inicial', 'Terapia manual 5 min'],
  stats,
} = Astro.props;

const badgeItems = badge ? badge.split('|').map((b) => b.trim()).filter(Boolean) : [];
const hasImage = !!image;
---

<section class={`relative overflow-hidden bg-white ${className}`} aria-labelledby="hero-title">
  <div class="absolute inset-0 -z-10 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0 bg-gradient-to-b from-primary-50/80 via-white to-white"></div>
    <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-accent-100/50 blur-3xl"></div>
    <div class="absolute top-1/3 -left-24 w-72 h-72 rounded-full bg-primary-100/60 blur-3xl"></div>
  </div>

  <Container class="relative py-fluid-12 md:py-fluid-16 lg:py-fluid-20">
    <div class="grid lg:grid-cols-2 gap-fluid-8 lg:gap-fluid-12 items-center">
      <div class="text-center lg:text-left">
        {badgeItems.length > 0 && (
          <div class="flex flex-wrap justify-center lg:justify-start gap-2 mb-5 animate-fade-in">
            {badgeItems.map((item, i) => (
              <span class:list={['badge badge-primary', i > 0 && 'hidden sm:inline-flex']}>{item}</span>
            ))}
          </div>
        )}

        <h1
          id="hero-title"
          class="text-fluid-4xl md:text-fluid-5xl font-heading font-bold text-neutral-900 text-balance mb-4 animate-slide-up"
        >
          {title}
        </h1>

        {subtitle && (
          <p class="text-fluid-base lg:text-fluid-lg text-neutral-600 mb-6 max-w-xl mx-auto lg:mx-0 animate-slide-up stagger-1">
            {subtitle}
          </p>
        )}

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center lg:justify-start gap-3 mb-7 animate-slide-up stagger-2">
          <Button
            href={ctaHref}
            variant={ctaVariant}
            size="lg"
            data-track="cta_click"
            data-track-source={ctaTrackSource}
            class="w-full sm:w-auto"
          >
            {ctaText}
          </Button>
          {secondaryCtaText && secondaryCtaHref && (
            <Button
              href={secondaryCtaHref}
              variant="ghost"
              size="lg"
              data-track="cta_click"
              data-track-source={`${ctaTrackSource}_secondary`}
              class="w-full sm:w-auto"
            >
              {secondaryCtaText}
            </Button>
          )}
        </div>

        {stats && stats.length > 0 && (
          <div
            class="flex flex-wrap items-stretch justify-center lg:justify-start gap-x-6 gap-y-4 py-4 border-y border-neutral-200/80 animate-slide-up stagger-3"
            role="list"
            aria-label="Destaques"
          >
            {stats.map((stat, i) => (
              <div
                class={`flex-1 min-w-[7rem] max-w-[11rem] text-center lg:text-left ${i > 0 ? 'lg:border-l lg:border-neutral-200 lg:pl-6' : ''}`}
                role="listitem"
              >
                <div class="text-fluid-xl font-heading font-bold text-primary-700 leading-tight">{stat.value}</div>
                <div class="text-fluid-xs text-neutral-500 mt-0.5">{stat.label}</div>
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="relative mx-auto w-full max-w-md lg:max-w-none animate-fade-in stagger-2">
        {hasImage ? (
          <div class="aspect-[4/3] rounded-3xl overflow-hidden shadow-card-hover border border-neutral-200 bg-neutral-100">
            <img
              src={image}
              alt={imageAlt || ''}
              width="1200"
              height="900"
              class="w-full h-full object-cover"
              loading="eager"
              decoding="async"
            />
          </div>
        ) : (
          <div class="relative aspect-[4/3]" aria-hidden="true">
            <div class="absolute inset-0 rounded-3xl bg-gradient-to-br from-primary-600 via-primary-700 to-primary-900 shadow-card-hover overflow-hidden">
              <svg class="absolute inset-0 w-full h-full opacity-15" viewBox="0 0 400 300" fill="none" aria-hidden="true">
                <circle cx="320" cy="60" r="90" stroke="white" stroke-width="1.5" />
                <circle cx="320" cy="60" r="60" stroke="white" stroke-width="1" />
                <path d="M0 240 Q100 180 200 230 T400 200" stroke="white" stroke-width="1.5" fill="none" />
                <path d="M0 270 Q120 220 220 260 T400 240" stroke="white" stroke-width="1" fill="none" />
              </svg>
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-24 h-24 md:w-28 md:h-28 rounded-full bg-white/15 backdrop-blur-sm flex items-center justify-center border border-white/25">
                  <svg class="w-12 h-12 md:w-14 md:h-14 text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                  </svg>
                </div>
              </div>
            </div>

            <div class="absolute -left-3 top-6 md:-left-6 bg-white rounded-xl shadow-card-hover border border-neutral-200 px-4 py-3 max-w-[12rem]">
              <div class="flex items-center gap-2">
                <span class="w-8 h-8 rounded-lg bg-secondary-100 text-secondary-700 flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                </span>
                <span class="text-fluid-xs font-medium text-neutral-700 leading-snug">{visualChips[0]}</span>
              </div>
            </div>

            <div class="absolute -right-3 bottom-6 md:-right-6 bg-white rounded-xl shadow-card-hover border border-neutral-200 px-4 py-3 max-w-[12rem]">
              <div class="flex items-center gap-2">
                <span class="w-8 h-8 rounded-lg bg-accent-100 text-accent-700 flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
                </span>
                <span class="text-fluid-xs font-medium text-neutral-700 leading-snug">{visualChips[1]}</span>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  </Container>
</section>
