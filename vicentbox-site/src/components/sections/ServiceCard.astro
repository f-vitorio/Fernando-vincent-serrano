---
import { siteConfig } from '../../types';
import { type Service } from '../../types';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';

interface Props {
  service: Service;
  layout?: 'vertical' | 'horizontal';
}

const { service, layout = 'vertical' } = Astro.props;
const isComingSoon = service.comingSoon === true;
const isHorizontal = layout === 'horizontal';
---

{isHorizontal ? (
  <Card padding="none" class="card-hover overflow-hidden">
    <div class="grid md:grid-cols-2 lg:grid-cols-5">
      {service.image && (
        <div class="aspect-[16/10] md:aspect-auto md:min-h-[16rem] bg-neutral-100 overflow-hidden lg:col-span-2" aria-hidden="true">
          <picture>
            <source srcset={service.image.replace(/\.jpg$/, '.webp')} type="image/webp" />
            <img
              src={service.image}
              alt={service.imageAlt || service.name}
              width="1200"
              height="750"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
      )}
      <div class="p-6 md:p-8 flex flex-col lg:col-span-3">
        <div class="flex items-start gap-4 mb-4">
          <div class="icon-wrapper icon-wrapper-primary flex-shrink-0" aria-hidden="true">
            <slot name={service.icon} />
          </div>
          <div class="min-w-0">
            <h3 class="text-fluid-lg font-heading font-semibold text-neutral-900">{service.name}</h3>
            <p class="text-fluid-base text-neutral-600 mt-2">{service.shortDescription}</p>
          </div>
        </div>

        <div class="mb-4">
          <p class="text-fluid-xl font-heading font-bold text-primary-700">{service.price}</p>
          {service.priceDetails && <p class="text-fluid-sm text-neutral-500 mt-1">{service.priceDetails}</p>}
        </div>

        <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-2 mb-6 flex-1" role="list">
          {service.features.slice(0, 6).map((feature, i) => (
            <li key={i} class="flex items-start gap-2 text-fluid-sm text-neutral-700" role="listitem">
              <svg class="w-4 h-4 text-secondary-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              {feature}
            </li>
          ))}
        </ul>

        <div class="pt-4 border-t border-neutral-100">
          {isComingSoon ? (
            <Button variant="outline" class="sm:w-auto" disabled>
              <Badge variant="neutral" class="mr-2">Em breve</Badge>
              {service.ctaText}
            </Button>
          ) : (
            <Button
              href={service.ctaUrl}
              variant={service.ctaType === 'whatsapp' ? 'whatsapp' : 'primary'}
              class="sm:w-auto"
              data-track="service_card_cta"
              data-track-source={service.id}
            >
              {service.ctaText}
            </Button>
          )}
        </div>
      </div>
    </div>
  </Card>
) : (
  <Card padding="none" class="card-hover h-full flex flex-col overflow-hidden">
    {service.image && (
      <div class="aspect-[16/10] bg-neutral-100 overflow-hidden flex-shrink-0" aria-hidden="true">
        <picture>
          <source srcset={service.image.replace(/\.jpg$/, '.webp')} type="image/webp" />
          <img
            src={service.image}
            alt={service.imageAlt || service.name}
            width="1200"
            height="750"
            class="w-full h-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </div>
    )}
    <div class="p-6 flex flex-col flex-1">
      <div class="icon-wrapper icon-wrapper-primary mx-auto mb-4" aria-hidden="true">
        <slot name={service.icon} />
      </div>

      <h3 class="text-fluid-lg font-heading font-semibold text-neutral-900 mb-2 text-center min-h-[2.75rem] flex items-center justify-center">{service.name}</h3>
      <p class="text-fluid-base text-neutral-600 mb-4 text-center min-h-[7rem]">{service.shortDescription}</p>

      <div class="text-center mb-4 min-h-[8rem] flex flex-col justify-start">
        <p class="text-fluid-xl font-heading font-bold text-primary-700">{service.price}</p>
        {service.priceDetails && <p class="text-fluid-sm text-neutral-500 mt-1">{service.priceDetails}</p>}
      </div>

      <ul class="space-y-2 mb-6 flex-1" role="list">
        {service.features.slice(0, 4).map((feature, i) => (
          <li key={i} class="flex items-center gap-2 text-fluid-sm text-neutral-700" role="listitem">
            <svg class="w-4 h-4 text-secondary-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            {feature}
          </li>
        ))}
        {service.features.length > 4 && (
          <li class="text-fluid-sm text-primary-600 font-medium flex items-center gap-1" role="listitem">
            <span>+{service.features.length - 4} mais benefícios</span>
          </li>
        )}
      </ul>

      <div class="pt-4 mt-auto border-t border-neutral-100">
        {isComingSoon ? (
          <Button variant="outline" class="w-full" disabled>
            <Badge variant="neutral" class="mr-2">Em breve</Badge>
            {service.ctaText}
          </Button>
        ) : (
          <Button
            href={service.ctaUrl}
            variant={service.ctaType === 'whatsapp' ? 'whatsapp' : 'primary'}
            class="w-full"
            data-track="service_card_cta"
            data-track-source={service.id}
          >
            {service.ctaText}
          </Button>
        )}
      </div>
    </div>
  </Card>
)}
