---
import { siteConfig, type FormData } from '../../types';
import { generateWhatsAppLink, validateFormData, getEstimatedTicket } from '../../utils/whatsapp';
import { trackFormSubmit, trackWhatsAppClick } from '../../utils/tracking';
import Button from '../ui/Button.astro';
import Input from '../ui/Input.astro';
import Container from '../ui/Container.astro';

interface Props {
  source: FormData['source'];
  title?: string;
  subtitle?: string;
  submitText: string;
  fields?: Array<'name' | 'email' | 'phone' | 'objective' | 'preferredTime' | 'injuries' | 'subject' | 'message'>;
  successMessage?: string;
  class?: string;
  redirectToObrigado?: boolean;
}

const {
  source,
  title,
  subtitle,
  submitText,
  fields = ['name', 'phone', 'objective', 'preferredTime'],
  successMessage,
  class: className = '',
  redirectToObrigado = true,
} = Astro.props;

const formType = source === 'consultoria' ? 'email' : 'whatsapp';
const estimatedTicket = getEstimatedTicket(source);
---

<div class={`bg-white rounded-2xl border border-neutral-200 p-6 md:p-8 shadow-card ${className}`}>
  {title && (
    <div class="text-center mb-8">
      <h2 class="text-fluid-2xl font-heading font-semibold text-neutral-900 mb-2">{title}</h2>
      {subtitle && <p class="text-fluid-base text-neutral-600">{subtitle}</p>}
    </div>
  )}

  <form
    id={`form-${source}`}
    class="space-y-5"
    data-source={source}
    data-form-type={formType}
    data-estimated-ticket={estimatedTicket}
    data-redirect={redirectToObrigado ? 'true' : 'false'}
    data-endpoint={siteConfig.formspreeEndpoint || ''}
    data-submit-text={submitText}
  >
    {fields.includes('name') && (
      <Input
        id={`${source}-name`}
        name="name"
        label="Nome completo"
        type="text"
        placeholder="Seu nome"
        required
        autocomplete="name"
      />
    )}

    {formType === 'email' && fields.includes('email') && (
      <Input
        id={`${source}-email`}
        name="email"
        label="E-mail"
        type="email"
        placeholder="seu@email.com"
        required
        autocomplete="email"
        inputMode="email"
      />
    )}

    {fields.includes('phone') && (
      <Input
        id={`${source}-phone`}
        name="phone"
        label="WhatsApp"
        type="tel"
        placeholder="(44) 99999-9999"
        required
        autocomplete="tel"
        inputMode="tel"
      />
    )}

    {fields.includes('objective') && (
      <Input
        id={`${source}-objective`}
        name="objective"
        label="Qual seu objetivo principal?"
        type="text"
        placeholder="Ex: Eliminar dores nas costas, voltar a correr, emagrecer..."
        autocomplete="off"
      />
    )}

    {fields.includes('preferredTime') && (
      <Input
        id={`${source}-preferredTime`}
        name="preferredTime"
        label="Melhor horário para treinar"
        type="select"
        placeholder="Selecione"
        options={[
          { value: 'manha-cedo', label: 'Manhã cedo (7h-9h)' },
          { value: 'manha', label: 'Manhã (8h-12h)' },
          { value: 'almoco', label: 'Horário de almoço (12h-14h)' },
          { value: 'tarde', label: 'Tarde (14h-18h)' },
          { value: 'noite', label: 'Noite (18h-21h)' },
          { value: 'flexivel', label: 'Tenho flexibilidade total' },
        ]}
      />
    )}

    {fields.includes('injuries') && (
      <Input
        id={`${source}-injuries`}
        name="injuries"
        label="Lesões, restrições ou condições médicas (opcional)"
        type="textarea"
        placeholder="Ex: Hérnia de disco lombar, hipertensão controlada, cirurgia de joelho..."
        rows={3}
      />
    )}

    {fields.includes('subject') && (
      <Input
        id={`${source}-subject`}
        name="subject"
        label="Assunto"
        type="select"
        placeholder="Selecione"
        options={[
          { value: 'duvida', label: 'Dúvida sobre serviços' },
          { value: 'agendamento', label: 'Agendamento de avaliação' },
          { value: 'parceria', label: 'Parceria / B2B' },
          { value: 'outro', label: 'Outro assunto' },
        ]}
      />
    )}

    {fields.includes('message') && (
      <Input
        id={`${source}-message`}
        name="message"
        label="Mensagem"
        type="textarea"
        placeholder="Conte como podemos ajudar..."
        required
        rows={4}
      />
    )}

    <Button
      type="submit"
      variant={formType === 'whatsapp' ? 'whatsapp' : 'primary'}
      size="lg"
      class="w-full"
      data-track="form_submit"
      data-track-source={source}
    >
      {submitText}
    </Button>

    <p class="text-center text-fluid-xs text-neutral-500">
      Seus dados são seguros e usados apenas para retorno do contato. Não fazemos spam.
    </p>
  </form>

  <div id={`form-${source}-success`} class="hidden text-center py-8" role="status" aria-live="polite">
    <svg class="w-16 h-16 mx-auto text-green-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
    <h3 class="text-fluid-xl font-heading font-semibold text-neutral-900 mb-2">
      {formType === 'whatsapp' ? 'Redirecionando para o WhatsApp...' : 'Enviado com sucesso!'}
    </h3>
    <p class="text-fluid-base text-neutral-600 mb-6">
      {successMessage || (formType === 'whatsapp'
        ? 'A conversa será aberta com sua mensagem pré-preenchida. É só enviar!'
        : 'Você receberá um e-mail de confirmação. Verifique também a caixa de spam.')}
    </p>
    {redirectToObrigado && (
      <a href={`/obrigado?source=${source}&type=${formType}`} class="btn btn-secondary">
        Continuar →
      </a>
    )}
  </div>
</div>

<script>
  import { validateFormData, generateWhatsAppLink } from '../../utils/whatsapp';
  import { trackFormSubmit, trackWhatsAppClick } from '../../utils/tracking';
  import type { FormData as LeadFormData } from '../../types';

  document.querySelectorAll<HTMLFormElement>('form[id^="form-"]').forEach((form) => {
    if (form.dataset.leadFormBound === 'true') return;
    form.dataset.leadFormBound = 'true';

    const source = form.dataset.source || '';
    const formType = form.dataset.formType || 'whatsapp';
    const estimatedTicket = Number(form.dataset.estimatedTicket || '0');
    const redirectToObrigado = form.dataset.redirect === 'true';
    const endpoint = form.dataset.endpoint || '';
    const submitText = form.dataset.submitText || 'Enviar';
    const successDiv = document.getElementById(`form-${source}-success`);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!successDiv) return;

      const formData = new FormData(form);
      const data: LeadFormData = {
        name: formData.get('name')?.toString() || '',
        email: formData.get('email')?.toString() || '',
        phone: formData.get('phone')?.toString() || '',
        objective: formData.get('objective')?.toString() || '',
        preferredTime: formData.get('preferredTime')?.toString() || '',
        subject: formData.get('subject')?.toString() || '',
        message: formData.get('message')?.toString() || '',
        injuries: formData.get('injuries')?.toString() || '',
        source: source as LeadFormData['source'],
        formType: formType as LeadFormData['formType'],
      };

      const validation = validateFormData(data);
      if (!validation.valid) {
        form.querySelectorAll('.invalid').forEach((el) => {
          el.classList.remove('invalid');
          el.removeAttribute('aria-invalid');
        });
        form.querySelectorAll('[id$="-error"]').forEach((el) => el.remove());
        Object.entries(validation.errors).forEach(([field, error]) => {
          const input = form.querySelector<HTMLElement>(`[name="${field}"]`);
          if (!input) return;
          input.setAttribute('aria-invalid', 'true');
          input.classList.add('invalid');
          let errorEl = input.parentElement?.querySelector<HTMLElement>(`#${field}-error`);
          if (!errorEl) {
            errorEl = document.createElement('p');
            errorEl.id = `${field}-error`;
            errorEl.className = 'text-fluid-sm text-red-600 mt-1.5';
            errorEl.setAttribute('role', 'alert');
            input.parentElement?.appendChild(errorEl);
          }
          errorEl.textContent = error;
        });
        return;
      }

      trackFormSubmit(source as LeadFormData['source'], estimatedTicket);

      if (formType === 'whatsapp') {
        const whatsappUrl = generateWhatsAppLink(data);
        trackWhatsAppClick('form');
        const win = window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
        if (!win) {
          window.location.href = whatsappUrl;
        }

        form.classList.add('hidden');
        successDiv.classList.remove('hidden');

        if (redirectToObrigado) {
          setTimeout(() => {
            window.location.href = `/obrigado?source=${source}&type=whatsapp`;
          }, 3000);
        }
        return;
      }

      if (!endpoint) {
        console.error('Formspree endpoint not configured');
        alert('Erro: configuração de e-mail não encontrada. Tente pelo WhatsApp.');
        return;
      }

      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Enviando...';
      }

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          form.classList.add('hidden');
          successDiv.classList.remove('hidden');
          if (redirectToObrigado) {
            setTimeout(() => {
              window.location.href = `/obrigado?source=${source}&type=email`;
            }, 3000);
          }
        } else {
          throw new Error('Falha no envio');
        }
      } catch (error) {
        console.error('Formspree error:', error);
        alert('Erro ao enviar. Tente novamente ou use o WhatsApp.');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = submitText;
        }
      }
    });

    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input, textarea, select').forEach((input) => {
      input.addEventListener('input', () => {
        input.classList.remove('invalid');
        input.removeAttribute('aria-invalid');
        input.parentElement?.querySelector(`#${input.name}-error`)?.remove();
      });
    });
  });
</script>